---
import SectionPageHeader from "../../components/SectionPageHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
  getSiteData,
  labelForEntry,
  routeForEntry,
} from "../../lib/content";
import { routeFor, withBase } from "../../lib/urls";

import {
  fieldNotesForDisplay,
  isCollectionEntry,
  collectionKindLabels,
} from "../../lib/content/collections";

const data = await getSiteData();

const atlasItems = [
  ...data.publicProjects.map((entry) => ({
    id: entry.data.id,
    title: entry.data.title,
    url: routeFor("projects", entry.data.slug),
    type: "Project",
    section: "projects",
    contentType: "project",
    collectionKind: undefined,
    subjects: entry.data.subjects,
    kind: "projects",
    stage: entry.data.stage,
    tags: entry.data.tags,
    language: undefined,
  })),
  ...fieldNotesForDisplay(data).map((entry) => ({
    id: entry.data.id,
    title: entry.data.title ?? entry.data.workingLabel ?? entry.data.id,
    url: routeForEntry(entry),
    type: labelForEntry(entry),
    kind: "notes",
    section: "field-notes",
    contentType: entry.data.entryKind,
    collectionKind: isCollectionEntry(entry) ? entry.data.collectionKind : undefined,
    subjects: entry.data.subjects,
    stage: entry.data.stage,
    tags: entry.data.tags,
    language: entry.data.language,
  })),
  ...data.publicExperiments.map((entry) => ({
    id: entry.data.id,
    title: entry.data.title ?? entry.data.workingLabel ?? entry.data.id,
    url: routeForEntry(entry),
    type: labelForEntry(entry),
    kind: "experiments",
    section: "experiments",
    contentType: entry.data.entryKind,
    collectionKind: undefined,
    subjects: entry.data.subjects,
    stage: entry.data.stage,
    tags: entry.data.tags,
    language: entry.data.language,
  })),
  ...data.publicArtifacts.map((entry) => ({
    id: entry.data.id,
    title: entry.data.title,
    url: routeForEntry(entry),
    type: labelForEntry(entry),
    kind: "artifacts",
    section: "artifacts",
    contentType: entry.data.artifactKind,
    collectionKind: undefined,
    subjects: entry.data.subjects,
    stage: entry.data.stage,
    tags: entry.data.tags,
    language: entry.data.language,
  })),
].sort((a, b) => a.title.localeCompare(b.title));

const tags = [...new Set(atlasItems.flatMap((item) => item.tags))].sort();

const tagLabels: Record<string, string> = {
  translation: "Translations",
};

const labelForTag = (tag: string) => tagLabels[tag] ?? tag;

const kindFilters = [
  { value: "", label: "All" },
  { value: "projects", label: "Projects" },
  { value: "notes", label: "Field Notes" },
  { value: "experiments", label: "Experiments" },
  { value: "artifacts", label: "Artifacts" },
];
---

<SiteLayout title="Paths & Atlas" currentSection="atlas">
  <SectionPageHeader
    title="Paths & Atlas"
    subtitle="The Corridor"
    introduction="The Atlas will visualize all content. 
  Curated Paths will propose thematic groupings."
  />

  <section
    class="filter-panel"
    aria-labelledby="filter-title"
    data-atlas-filters
  >
    <p id="filter-title" class="eyebrow">Browse the Index</p>

    <div class="filter-panel__group">
      <p class="meta">Content kind</p>

      <div class="filter-list" role="group" aria-label="Atlas content kinds">
        {
          kindFilters.map((filter) => (
            <button
              class="filter-button"
              type="button"
              data-kind-filter={filter.value}
              aria-pressed={filter.value === "" ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="filter-panel__group">
      <p class="meta">Tag</p>

      {
        tags.length > 0 ? (
          <div class="filter-list" role="group" aria-label="Atlas tags">
            <button
              class="filter-button"
              type="button"
              data-tag-filter=""
              aria-pressed="true"
            >
              All
            </button>

            {tags.map((tag) => (
              <button
                class="filter-button"
                type="button"
                data-tag-filter={tag}
                aria-pressed="false"
              >
                {labelForTag(tag)}
              </button>
            ))}
          </div>
        ) : (
          <p class="muted">
            No editorial tag has been approved yet.
          </p>
        )
      }
    </div>

    <p class="meta" data-filter-status aria-live="polite"></p>
  </section>

  <ol class="atlas-list" data-atlas-list>
    {
      atlasItems.map((item) => (
        <li
          class="atlas-row"
          data-atlas-item
          data-content-id={item.id}
          data-section={item.section}
          data-type={item.contentType}
          data-collection-kind={item.collectionKind}
          data-subjects={JSON.stringify(item.subjects)}
          data-kind={item.kind}
          data-tags={item.tags.join(" ")}
        >
          <span class="atlas-type">
            {item.type}
            {item.collectionKind && (" · " + collectionKindLabels[item.collectionKind])}
          </span>
          <a class="atlas-title" href={withBase(item.url)}>{item.title}</a>
          <span class="meta">
            {item.stage}{item.language && ` · ${item.language.toUpperCase()}`}
          </span>
        </li>
      ))
    }
  </ol>
</SiteLayout>

<script>
  type AtlasFilterElements = {
    kindButtons: HTMLButtonElement[];
    tagButtons: HTMLButtonElement[];
    entries: HTMLElement[];
    status: HTMLElement | null;
  };

  type AtlasFilterState = {
    activeKind: string;
    activeTag: string;
    elements: AtlasFilterElements;
  };

  const getAtlasFilterElements = (
    panel: HTMLElement,
  ): AtlasFilterElements => ({
    kindButtons: Array.from(
      panel.querySelectorAll<HTMLButtonElement>(
        "[data-kind-filter]",
      ),
    ),
    tagButtons: Array.from(
      panel.querySelectorAll<HTMLButtonElement>(
        "[data-tag-filter]",
      ),
    ),
    entries: Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-atlas-item]",
      ),
    ),
    status: panel.querySelector<HTMLElement>(
      "[data-filter-status]",
    ),
  });

  const readFilterFromUrl = (
    state: AtlasFilterElements,
  ): AtlasFilterState => {
    const currentUrl =
      new URL(window.location.href);
    const requestedKind =
      currentUrl.searchParams.get("kind") ?? "";
    const requestedTag =
      currentUrl.searchParams.get("tag") ?? "";

    return {
      activeKind: state.kindButtons.some(
        (button) =>
          button.dataset.kindFilter === requestedKind
      )
        ? requestedKind
        : "",
      activeTag: state.tagButtons.some(
        (button) =>
          button.dataset.tagFilter === requestedTag
      )
        ? requestedTag
        : "",
      elements: state,
    };
  };

  const applyFilterState = (
    state: AtlasFilterState,
    updateUrl = true,
  ) => {
    let visible = 0;

    state.elements.entries.forEach((entry) => {
      const tags = (entry.dataset.tags ?? "").split(" ").filter(Boolean);
      const matchesKind =
        !state.activeKind ||
        entry.dataset.kind === state.activeKind;
      const matchesTag =
        !state.activeTag || tags.includes(state.activeTag);
      const show = matchesKind && matchesTag;

      entry.hidden = !show;
      if (show) visible += 1;
    });

    state.elements.kindButtons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.kindFilter === state.activeKind),
      );
    });

    state.elements.tagButtons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.tagFilter === state.activeTag),
      );
    });

    if (state.elements.status) {
      state.elements.status.textContent = `${visible} ${
        visible === 1 ? "item" : "items"
      }`;
    }

    if (updateUrl) {
      const url = new URL(window.location.href);

      if (state.activeKind) {
        url.searchParams.set("kind", state.activeKind);
      } else {
        url.searchParams.delete("kind");
      }

      if (state.activeTag) {
        url.searchParams.set("tag", state.activeTag);
      } else {
        url.searchParams.delete("tag");
      }

      // Conserva indice e posizione di scorrimento gestiti da ClientRouter.
      window.history.replaceState(window.history.state, "", url);
    }
  };

  const bindFilterControls = (
    state: AtlasFilterState,
  ) => {
    state.elements.kindButtons.forEach((button) => {
      button.addEventListener("click", () => {
        state.activeKind =
          button.dataset.kindFilter ?? "";
        applyFilterState(state);
      });
    });

    state.elements.tagButtons.forEach((button) => {
      button.addEventListener("click", () => {
        state.activeTag =
          button.dataset.tagFilter ?? "";
        applyFilterState(state);
      });
    });
  };

  const initializeAtlasFilters = (
    panel: HTMLElement,
  ) => {
    const elements = getAtlasFilterElements(panel);
    const state = readFilterFromUrl(elements);

    bindFilterControls(state);
    applyFilterState(state, false);
  };

  window.fabrizioWebhome?.initOnAstroLoad?.({
    selector: "[data-atlas-filters]",
    initializedAttribute: "initialized",
    initializer: initializeAtlasFilters,
  });
</script>
