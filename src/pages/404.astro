---
import SiteLayout from "../layouts/SiteLayout.astro";
import SectionPageHeader from "../components/SectionPageHeader.astro";
---

<SiteLayout title="Error 404" currentSection="home">
  <SectionPageHeader
    title="Error 404"
    introduction="This room is not here."
  />
  <div class="information-page">
    <div class="information-page__section information-page__section--wide">
      <p>The address may have changed, or the content may still be a private draft.</p>
    </div>
  </div>
</SiteLayout>
