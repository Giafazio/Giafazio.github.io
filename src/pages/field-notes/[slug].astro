---
import {
  render,
} from "astro:content";

import {
  isWrittenFieldNote,
  isCollectionEntry,
  fieldNotesForDisplay,
} from "../../lib/content/collections";
import type { FieldNoteEntry } from "../../lib/content/types";
import CollectionContent from "../../components/collections/CollectionContent.astro";

import LongformArticle from "../../components/LongformArticle.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

import {
  formatCreationDate,
  getSiteData,
} from "../../lib/content";

import { publicAsset } from "../../lib/urls";

export async function getStaticPaths() {
  const data = await getSiteData();

  return fieldNotesForDisplay(data).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: FieldNoteEntry;
}

const { entry } = Astro.props;
const note = isWrittenFieldNote(entry) ? entry.data : undefined;
const { Content, headings } = await render(entry);

const pageTitle =
  entry.data.title ??
  note?.workingLabel ??
  "Untitled";

const kindLabel =
  entry.data.entryKind === "site-note"
    ? "Site note"
    : "Thought";

const isLongform =
  note?.presentation === "longform";
---

<SiteLayout
  title={pageTitle}
  description={isCollectionEntry(entry) ? entry.data.summary : undefined}
  currentSection="field-notes"
  lang={entry.data.language ?? "en"}
  contentClass={note?.hyphenate ? "hyphenated-content" : ""}
>
  {
    isCollectionEntry(entry) ? (
      <CollectionContent collection={entry.data} hasIntroduction={Boolean(entry.body?.trim())}>
        {entry.body?.trim() && <Content />}
      </CollectionContent>
    ) : note && (isLongform ? (
      <LongformArticle
        title={pageTitle}
        kindLabel={kindLabel}
        language={entry.data.language ?? "en"}
        stage={entry.data.stage}
        authorialCredit={note.authorialCredit}
        authorialDateLabel={note.authorialDateLabel}
        pdfAsset={note.pdfAsset}
        headings={headings}
        showTableOfContents={note.showTableOfContents}
      >
        <Content />
      </LongformArticle>
    ) : (
      <article class="field-note-article">
        <header class="article-header">
          <p class="meta">
            {kindLabel}
            {` · ${formatCreationDate(note.creationDate)}`}
          </p>

          <h1>{pageTitle}</h1>

        </header>

        <div
          class:list={[
            "article-body",
            {
              "article-body--indented":
                note.indentParagraphs,
            },
          ]}
        >
          <Content />
        </div>

        {
          note.pdfAsset && (
            <p class="artifact-actions">
              <a href={publicAsset(note.pdfAsset)}>
                Apri il PDF
              </a>
            </p>
          )
        }
      </article>
    ))
  }
</SiteLayout>
