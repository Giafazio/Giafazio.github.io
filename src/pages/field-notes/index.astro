---
import EmptyState from
  "../../components/EmptyState.astro";

import EntryGallery from
  "../../components/EntryGallery.astro";

import SectionPageHeader from
  "../../components/SectionPageHeader.astro";

import SiteLayout from
  "../../layouts/SiteLayout.astro";

import {
  getSiteData,
} from "../../lib/content";

import { fieldNotesForDisplay } from "../../lib/content/collections";

const data = await getSiteData();
// La playlist apre questo indice; gli altri contenuti conservano il loro ordine.
const entries = [...fieldNotesForDisplay(data)].sort((a, b) =>
  Number(b.data.id === "passi-sparsi-tra-spicchi-di-mondi") -
  Number(a.data.id === "passi-sparsi-tra-spicchi-di-mondi"),
);
---

<SiteLayout title="Field Notes & Thoughts" currentSection="field-notes">
  <SectionPageHeader
    title="Field Notes & Thoughts"
    subtitle="The Living Room"
    introduction="A place for notes about this site, Thoughts
  about stuff that attract my attention
  and Collections of things I like."
  />

  {
    entries.length > 0 ? (
      <EntryGallery
        entries={entries}
        variant="living-room"
        ariaLabel="Field Notes and Thoughts"
      />
    ) : (
      <EmptyState
        title="Index ready"
        text="No Field Note or Thought is public yet. The current draft remains excluded from this index and from the generated routes."
      />
    )
  }
</SiteLayout>
