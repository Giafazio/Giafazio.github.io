---
import { routeForEntry } from "../../lib/content";
import {
  render,
} from "astro:content";

import ArtifactDetail from
  "../../components/ArtifactDetail.astro";

import SiteLayout from
  "../../layouts/SiteLayout.astro";

import {
  getSiteData,
  resolveArtifactRoute,
  type ProjectEntry,
  type ArtifactEntry,
} from "../../lib/content";

import {
  withBase,
} from "../../lib/urls";

export async function getStaticPaths() {
  const data = await getSiteData();

  return data.publicArtifacts.map(
    (artifact) => {
      const route = resolveArtifactRoute(artifact, data.publicProjects);

      return {
        params: {
          slug: artifact.data.slug,
        },

        props: {
          artifact,
          projects: data.publicProjects,

          destination:
            route.kind === "standalone" ? null : withBase(route.path),
        },
      };
    },
  );
}

interface Props {
  projects: readonly ProjectEntry[];
  artifact: ArtifactEntry;
  destination: string | null;
}

const {
  projects,
  artifact,
  destination,
} = Astro.props;

/*
 * Gli artifact appartenenti a un progetto
 * conservano la propria pagina canonica
 * interna al progetto.
 */
if (destination) {
  return Astro.redirect(
    destination,
    301,
  );
}

const { Content } =
  await render(artifact);
---

<SiteLayout
  canonicalPath={routeForEntry(artifact, projects)}
  title={artifact.data.title}
  description={artifact.data.summary}
  currentSection="experiments"
  lang={artifact.data.language ?? "en"}
>
  <ArtifactDetail projects={projects} artifact={artifact}>
    <Content />
  </ArtifactDetail>
</SiteLayout>