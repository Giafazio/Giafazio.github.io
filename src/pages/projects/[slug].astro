---
import type { CollectionEntry } from "astro:content";
import ProjectContents from "../../components/ProjectContents.astro";
import ComicGallery from "../../components/ComicGallery.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getProjectContents, getSiteData } from "../../lib/content";
import ProjectHeader from
  "../../components/ProjectHeader.astro";



export async function getStaticPaths() {
  const data = await getSiteData();
  return data.publicProjects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const data = await getSiteData();
const contents = getProjectContents(data, project.data.id);
const sidebarIds = project.data.sidebarContentIds ?? [];
const sidebarEntries = contents.filter((entry) => sidebarIds.includes(entry.data.id));
const mainEntries = contents.filter((entry) => !sidebarIds.includes(entry.data.id));
const groups = project.data.contentGroups ?? [];
const ungrouped = mainEntries.filter((entry) => !entry.data.projects.find((relation) => relation.id === project.data.id)?.group);
---

<SiteLayout
  title={project.data.title}
  description={project.data.summary}
  currentSection="projects"
>
  
  <article data-project={project.data.id}>
    <ProjectHeader project={project} />

      {project.data.id === "fumettonzi" ? <ComicGallery entries={contents} initialDisplay="mixtape" /> : <div
        class={
          project.data.roadmap.length > 0 || sidebarEntries.length > 0
            ? "project-page-sections project-page-sections--with-growing"
            : "project-page-sections"
        }
      >
        <div class="project-page-contents">
        {groups.map((group) => (
          <section class="project-content-section" aria-labelledby={`group-${group.id}`}>
            <h2 class="project-page-section-title" id={`group-${group.id}`}>{group.title}</h2>
            <ProjectContents
              entries={mainEntries.filter((entry) => entry.data.projects.some((relation) => relation.id === project.data.id && relation.group === group.id))}
              projectId={project.data.id}
            />
          </section>
        ))}
        {(groups.length === 0 || ungrouped.length > 0 || project.data.externalContents.length > 0) && <section aria-labelledby="project-contents-title">
          <h2
            class="project-page-section-title"
            id="project-contents-title"
          >
            Contents
          </h2>

          <ProjectContents
            entries={ungrouped}
            repositoryPreview={project.data.id === "esperimenti-di-portafoglio" ? project.data.preview : undefined}
            externalContents={
              project.data.externalContents
            }
            projectId={project.data.id}
            summaryEntryIds={
              project.data.detailSummaryContentIds
            }
          />
        </section>}
        </div>

        <div class="project-page-sidebar">
        {
          project.data.roadmap.length > 0 && (
            <aside
              class="growing-next"
              aria-labelledby="growing-next-title"
            >
              <h2
                class="growing-next__title"
                id="growing-next-title"
              >
                Growing next
              </h2>

              <ul class="growing-next__list">
                {project.data.roadmap.map((item) => (
                  <li class="growing-next__item">
                    <div class="growing-next__topline">
                      <h3>{item.title}</h3>

                      <span class="meta">
                        {item.stage}
                      </span>
                    </div>

                    <p>{item.statement}</p>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
        {sidebarEntries.length > 0 && <ProjectContents entries={sidebarEntries} projectId={project.data.id} showSummary />}
        </div>
      </div>}

  </article>
</SiteLayout>
