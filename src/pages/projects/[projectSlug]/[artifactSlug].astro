---
import { routeForEntry } from "../../../lib/content";
import {
  render,
} from "astro:content";

import ArtifactDetail from
  "../../../components/ArtifactDetail.astro";
import MusicPiece from "../../../components/MusicPiece.astro";
import ProjectTitleButton from "../../../components/ProjectTitleButton.astro";
import musicTile from "../../../assets/navigation/tiles/maio1_4.png";

import SiteLayout from
  "../../../layouts/SiteLayout.astro";

import {
  getSiteData,
  resolveArtifactRoute,
  getProjectContents,
  type ArtifactEntry,
  type ProjectEntry,
} from "../../../lib/content";

export async function getStaticPaths() {
  const data = await getSiteData();

  return data.publicArtifacts.flatMap(
    (artifact) => {
      const route = resolveArtifactRoute(artifact, data.publicProjects);
      if (route.kind === "standalone") return [];
      const project = route.project;

      const sequenceArtifacts =
        project.data.artifactSequence
          ? getProjectContents(
              data,
              project.data.id,
            ).filter(
              (
                entry,
              ): entry is ArtifactEntry =>
                entry.collection ===
                "artifacts",
            )
          : [];

      const currentIndex =
        sequenceArtifacts.findIndex(
          (entry) =>
            entry.data.id ===
            artifact.data.id,
        );

      const hasSequence =
        currentIndex >= 0 &&
        sequenceArtifacts.length > 1;

      const previousArtifact =
        hasSequence
          ? sequenceArtifacts[
              (
                currentIndex -
                1 +
                sequenceArtifacts.length
              ) %
                sequenceArtifacts.length
            ]
          : undefined;

      const nextArtifact =
        hasSequence
          ? sequenceArtifacts[
              (
                currentIndex + 1
              ) %
                sequenceArtifacts.length
            ]
          : undefined;

      return [
        {
          params: route.params,

          props: {
            artifact,
            projects: data.publicProjects,
            project,
            previousArtifact,
            nextArtifact,
          },
        },
      ];
    },
  );
}

interface Props {
  projects: readonly ProjectEntry[];
  artifact: ArtifactEntry;
  project: ProjectEntry;
  previousArtifact?: ArtifactEntry;
  nextArtifact?: ArtifactEntry;
}

const {
  projects,
  artifact,
  project,
  previousArtifact,
  nextArtifact,
} = Astro.props;

const { Content } =
  await render(artifact);
---

<SiteLayout
  canonicalPath={routeForEntry(artifact, projects)}
  title={artifact.data.title}
  description={artifact.data.summary}
  currentSection="projects"
  lang={artifact.data.language ?? "en"}
>
  {artifact.data.artifactKind === "audio" ? <>
    <header class="project-detail-header project-detail-header--project">
      <div class="project-detail-header__heading"><ProjectTitleButton project={project} variant="heading" /></div>
    </header>
    <MusicPiece projects={projects} artifact={artifact} detail tile={musicTile.src}><Content /></MusicPiece>
  </> : <ArtifactDetail
    projects={projects}
    artifact={artifact}
    project={project}
    previousArtifact={previousArtifact}
    nextArtifact={nextArtifact}
  >
    <Content />
  </ArtifactDetail>}
</SiteLayout>
