      "author": "Carlo Goldoni",
      "work": "La locandiera"
    }
  ],
  "incerta": [
    {
      "character": "Teeteto",
      "text": "Non ho capito.",
      "url": "https://it.wikisource.org/wiki/Il_Sofista_e_l'Uomo_politico/Il_Sofista/XV",
      "author": "Platone",
      "work": "Il Sofista"
    },
    {
      "character": "Teeteto",
      "text": "Neanche a questo so che cosa io debba rispondere.",
      "url": "https://it.wikisource.org/wiki/Il_Sofista_e_l'Uomo_politico/Il_Sofista/XV",
      "author": "Platone",
      "work": "Il Sofista"
    },
    {
      "character": "Simplicio",
      "text": "Questo è quello ch’io non capisco e ch’io vorrei intendere.",
      "url": "https://it.wikisource.org/wiki/Dialogo_sopra_i_due_massimi_sistemi_del_mondo_tolemaico_e_copernicano/Giornata_seconda",
      "author": "Galileo Galilei",
      "work": "Dialogo sopra i due massimi sistemi del mondo"
    },
    {
      "character": "Frangiotto",
      "text": "Spiegatevi, ch’io non vi capisco.",
      "url": "https://it.wikisource.org/wiki/Pagina:Goldoni_-_Opere_complete,_Venezia_1910,_VII.djvu/133",
      "author": "Carlo Goldoni",
      "work": "La castalda"
    },
    {
      "character": "Raimondo",
      "text": "Io non so che vi dite.",
      "url": "https://it.wikisource.org/wiki/Le_massere/Atto_II",
      "author": "Carlo Goldoni",
      "work": "Le massere"
    },
    {
      "character": "Il Direttore",
      "text": "Ma io non comprendo più nulla!",
      "url": "https://it.wikisource.org/wiki/Sei_personaggi_in_cerca_d'autore/Sei_personaggi_in_cerca_d'autore",
      "author": "Luigi Pirandello",
      "work": "Sei personaggi in cerca d’autore"
    },
    {
      "character": "Il Capocomico",
      "text": "Io non mi raccapezzo piú!",
      "url": "https://it.wikisource.org/wiki/Sei_personaggi_in_cerca_d'autore_(1965)/Atto_unico",
      "author": "Luigi Pirandello",
      "work": "Sei personaggi in cerca d’autore"
    },
    {
      "character": "Il Conte",
      "text": "Per dirvi la verità, non capisco niente.",
      "url": "https://it.wikisource.org/wiki/Pagina:Goldoni_-_Opere_complete,_Venezia_1914,_XVIII.djvu/321",
      "author": "Carlo Goldoni",
      "work": "La casa nova"
    },
    {
      "character": "Mingone",
      "text": "Non capisco.",
      "url": "https://it.wikisource.org/wiki/Pagina:Goldoni_-_Opere_complete,_Venezia_1922,_XXI.djvu/165",
      "author": "Carlo Goldoni",
      "work": "La gelosia di Lindoro"
    },
    {
      "character": "Arlecchino",
      "text": "Son confuso, son stordìo, son fora de mi.",
      "url": "https://it.wikisource.org/wiki/Pagina:Goldoni_-_Opere_complete,_Venezia_1923,_XXII.djvu/53",
      "author": "Carlo Goldoni",
      "work": "Gli amanti timidi"
    },
    {
      "character": "Il Conte",
      "text": "Spiegatevi, signore; non capisco.",
      "url": "https://it.wikisource.org/wiki/Pagina:Goldoni_-_Opere_complete,_Venezia_1930,_XXIX.djvu/446",
      "author": "Carlo Goldoni",
      "work": "La diavolessa"
    },
    {
      "character": "Leonide",
      "text": "Io non capisco niente.",
      "url": "https://it.wikisource.org/wiki/I_malcontenti/Atto_II",
      "author": "Carlo Goldoni",
      "work": "I malcontenti"
    },
    {
      "character": "Bertoldo",
      "text": "Io non mi raccapezzo bene",
      "url": "https://it.wikisource.org/wiki/Enrico_IV_(1965)/Atto_I",
      "author": "Luigi Pirandello",
      "work": "Enrico IV"
    },
    {
      "character": "Ludovico",
      "text": "Io ancora non mi raccapezzo.",
      "url": "https://it.wikisource.org/wiki/Vestire_gli_ignudi/Atto_III",
      "author": "Luigi Pirandello",
      "work": "Vestire gli ignudi"
    },
    {
      "character": "Marta",
      "text": "Le dico proprio che non capisco.",
      "url": "https://it.wikisource.org/wiki/L'amica_delle_mogli_(commedia)/Atto_I",
      "author": "Luigi Pirandello",
      "work": "L’amica delle mogli"
    },
    {
      "character": "Anna",
      "text": "Perché? Non capisco...",
      "url": "https://it.wikisource.org/wiki/Pagina:Pirandello_-_Maschere_nude,_Volume_II_-_Verona,_Mondadori,_1965.djvu/140",
      "author": "Luigi Pirandello",
      "work": "L’amica delle mogli"
    },
    {
      "character": "Il Commesso viaggiatore",
      "text": "Io non capisco niente...",
      "url": "https://it.wikisource.org/wiki/L'imbecille_(Commedia,_1965)",
      "author": "Luigi Pirandello",
      "work": "L’imbecille"
    },
    {
      "character": "Giorgio",
      "text": "Non capisco.",
      "url": "https://it.wikisource.org/wiki/Non_si_sa_come/Atto_II",
      "author": "Luigi Pirandello",
      "work": "Non si sa come"
    },
    {
      "character": "Elj",
      "text": "Io non comprendo piú nulla",
      "url": "https://it.wikisource.org/wiki/Trovarsi/Atto_II",
      "author": "Luigi Pirandello",
      "work": "Trovarsi"
    },
    {
      "character": "Personaggio indicato con ***",
      "text": "Che vuol dire? Io non so nulla!",
      "url": "https://it.wikisource.org/wiki/Quando_si_è_qualcuno/Atto_II",
