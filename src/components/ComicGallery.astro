---
import ComicSquare from "./ComicSquare.astro";
import { routeForEntry, type PublishableEntry } from "../lib/content";
import { withBase } from "../lib/urls";
interface Props { entries: PublishableEntry[]; initialDisplay: "mixtape" | "wall" }
const { entries, initialDisplay } = Astro.props;
const views = [{ id: "mixtape", title: "Mixtape" }, { id: "wall", title: "Record Wall" }];
---
<section data-comic-gallery aria-label="Gallery">
  <h2 class="project-page-section-title gallery-heading">Gallery</h2>
  <div class="preview-views" role="group" aria-label="Visualizzazione">
    {views.map((view) => <button type="button" data-display={view.id} aria-pressed={view.id === initialDisplay}>{view.title}</button>)}
  </div>
  {views.map((view) => (
    <ol class:list={["comic-preview", `comic-preview--${view.id}`]} data-panel={view.id} hidden={view.id !== initialDisplay} aria-label={view.title}>
      {entries.map((entry) => (
        <li>
          <a href={withBase(routeForEntry(entry))}>
            {"previewAsset" in entry.data && entry.data.previewAsset && (
              view.id === "wall" ? <ComicSquare id={entry.data.id} src={entry.data.previewAsset} />
                : <img src={withBase(entry.data.previewAsset)} alt="" loading="lazy" />
            )}
            <h3>{entry.data.title}</h3>
          </a>
        </li>
      ))}
    </ol>
  ))}
</section>
<script>
  function initializeComicGalleries() {
    document.querySelectorAll<HTMLElement>("[data-comic-gallery]").forEach((gallery) => {
      if (gallery.dataset.initialized) return;
      gallery.dataset.initialized = "true";
      gallery.querySelectorAll<HTMLButtonElement>("[data-display]").forEach((button) => {
        button.addEventListener("click", () => {
          gallery.querySelectorAll<HTMLButtonElement>("[data-display]").forEach((control) => control.setAttribute("aria-pressed", String(control === button)));
          gallery.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => { panel.hidden = panel.dataset.panel !== button.dataset.display; });
        });
      });
    });
  }
  initializeComicGalleries();
  document.addEventListener("astro:page-load", initializeComicGalleries);
</script>
<style>
  .comic-preview[hidden] { display: none; }
  .preview-views button { padding: 0; border: 0; background: none; color: var(--link); font: inherit; cursor: pointer; }
  .preview-views button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .gallery-heading { margin-bottom: .75rem; }
  .preview-views { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; margin: 0 0 2rem; }
  .preview-views [aria-pressed="true"] { font-weight: bold; text-decoration-thickness: 2px; }
  .comic-preview { list-style: none; padding: 0; margin: 0; display: grid; gap: 2rem; }
  .comic-preview li { min-width: 0; }
  .comic-preview a { display: block; color: inherit; text-decoration: none; }
  .comic-preview a:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
  .comic-preview img { display: block; width: 100%; object-fit: contain; }
  .comic-preview h3 { font-family: var(--font-display); font-size: 1.4rem; margin: .8rem 0 0; }
  .comic-preview--mixtape { gap: 3rem; }
  .comic-preview--mixtape a { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 2rem; align-items: center; }
  .comic-preview--mixtape img { max-height: 38rem; }
  .comic-preview--mixtape li:nth-child(even) img { grid-column: 2; grid-row: 1; }
  .comic-preview--mixtape li:nth-child(even) h3 { grid-column: 1; grid-row: 1; text-align: right; }
  .comic-preview--mixtape h3 { font-size: clamp(1.5rem, 3vw, 2.4rem); }
  .comic-preview--wall { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  @media (max-width: 1000px) { .comic-preview--wall { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .comic-preview--wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .comic-preview--mixtape a { display: flex; flex-direction: column; align-items: stretch; gap: .5rem; }
    .comic-preview--mixtape li:nth-child(even) h3 { text-align: left; }
  }
</style>
