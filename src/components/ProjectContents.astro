---
import ComicSquare from "./ComicSquare.astro";
import type {
  CollectionEntry,
} from "astro:content";

import {
  labelForEntry,
  routeForEntry,
  type PublishableEntry,
} from "../lib/content";

import { withBase } from "../lib/urls";

type ExternalContent =
  CollectionEntry<"projects">["data"]["externalContents"][number];

interface Props {
  gallery?: boolean;
  presentation?: "cards" | "comic-gallery" | "reading-list";
  entries: PublishableEntry[];
  externalContents?: ExternalContent[];
  repositoryPreview?: CollectionEntry<"projects">["data"]["preview"];
  projectId?: string;
  showEmpty?: boolean;
  showSummary?: boolean;
  summaryEntryIds?: readonly string[];
}

const {
  entries,
  externalContents = [],
  repositoryPreview,
  projectId,
  showEmpty = true,
  gallery = false,
  presentation = "cards",
  showSummary = false,
  summaryEntryIds = [],
} = Astro.props;

const projectContentKind = (
  entry: PublishableEntry,
) =>
  "artifactKind" in entry.data
    ? entry.data.artifactKind
    : labelForEntry(entry);

const languageLabel = (
  language: string,
) =>
  language === "it"
    ? "ITA"
    : language.toUpperCase();


const publicationKinds = new Set([
  "article",
  "research article",
]);


const localContents = entries.map(
  (entry, index) => {
    const relation =
      projectId
        ? entry.data.projects.find(
            (item) =>
              item.id === projectId,
          )
        : undefined;

    return {
      id: entry.data.id,
      isArtifact: "artifactKind" in entry.data,
      translation: "artifactKind" in entry.data && entry.data.translation,
      medium: "artifactKind" in entry.data ? entry.data.medium : undefined,

      title:
        entry.data.title ??
        entry.data.workingLabel ??
        "Untitled",

      summary: 
        entry.data.summary,

      kind:
        projectContentKind(entry),

      stage:
        entry.data.stage,

      language:
        entry.data.language,

      preview:
        "artifactKind" in entry.data
          ? entry.data.artifactKind === "crossword"
            ? entry.data.crossword?.gridAsset
            : entry.data.previewAsset
          : undefined,

      previewRendering:
        "artifactKind" in entry.data
          ? entry.data.previewRendering
          : "auto",

      wordPreview:
        "artifactKind" in entry.data &&
        entry.data.artifactKind === "game"
          ? entry.data.fourWordsGame
              ?.rounds[0]?.words.slice(0, 4)
          : undefined,

      themeProjectId:
        entry.data.projects[0]?.id,

      href:
        routeForEntry(entry),

      elsewhere: false,

      highlight:
        relation?.highlight ?? false,

      order:
        relation?.order ??
        index,
    };
  },
);

const elsewhereContents =
  externalContents.map(
    (content) => ({
      id: `external:${content.href}`,
      isArtifact: false,
      translation: false,
      medium: undefined,
      title: content.title,
      kind: content.kind,
      stage: content.stage,
      language: content.language,

      preview: content.kind === "repository" ? repositoryPreview?.asset : undefined,
      wordPreview: undefined,
      previewRendering: "auto" as const,

      themeProjectId: projectId,
      href: content.href,
      elsewhere: true,
      highlight: false,
      summary: undefined,
      order:
        content.order ??
        Number.MAX_SAFE_INTEGER,
    }),
  );

const projectContents = [
  ...localContents,
  ...elsewhereContents,
].sort((first, second) => {
  if (
    first.highlight !==
    second.highlight
  ) {
    return first.highlight
      ? -1
      : 1;
  }

  const orderDifference =
    first.order - second.order;

  if (orderDifference !== 0) {
    return orderDifference;
  }

  return first.title.localeCompare(
    second.title,
  );
});

const isScrollableGallery =
  gallery && presentation !== "reading-list" && projectContents.length > 2;
---

{
  projectContents.length > 0 ? (
    <ul
      class:list={[
        "project-content-grid",
        `project-content-grid--${presentation}`,
        {
          "project-content-grid--gallery":
            isScrollableGallery,
        },
      ]}
      tabindex={
        isScrollableGallery || presentation === "reading-list"
          ? "0"
          : undefined
      }
      aria-label={
        isScrollableGallery
          ? "Project contents gallery"
          : undefined
      }
    >
      {projectContents.map((content) => (
        <li
          class="project-content-card"
          data-project={content.themeProjectId}
        >
          <a
            class="project-content-card__link"
            href={withBase(content.href)}
          >
            {presentation === "comic-gallery" && content.preview && <ComicSquare id={content.id} src={content.preview} />}
            <span
              class:list={[
                "project-content-card__title",
                {
                  "project-content-card__title--artifact": content.isArtifact,
                  "project-content-card__title--repository":
                    content.kind === "repository",

                  "project-content-card__title--publication":
                    publicationKinds.has(
                      content.kind,
                    ),
                },
              ]}
            >
              {content.title}
            </span>

            {
              (
                showSummary ||
                summaryEntryIds.includes(content.id)
              ) &&
              content.summary && (
                  <span class="project-content-card__summary">
                    {content.summary}
                  </span>
                )
            }
            {
              presentation !== "comic-gallery" && content.preview && (
                <span
                  class:list={[
                    "project-content-card__preview",

                    content.previewRendering ===
                      "pixelated" &&
                      "project-content-card__preview--pixelated",
                  ]}
                >
                  <img
                    src={withBase(
                      content.preview,
                    )}
                    alt={content.elsewhere ? repositoryPreview?.alt ?? "" : ""}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )
            }

              {
                content.wordPreview && (
                  <span
                    class="project-content-card__word-preview"
                    role="img"
                    aria-label={`${content.title} preview: four hidden words`}
                  >
                    {
                      content.wordPreview.map(() => (
                        <span aria-hidden="true">
                          ?
                        </span>
                      ))
                    }
                  </span>
                )
              }
            
            <span class="meta project-content-card__meta">
              {content.kind}
              {content.translation && " · Translation"}
              {content.medium && ` · ${content.medium}`}
              {" · "}
              {content.stage}

              {
                content.language && (
                  <>
                    {" · "}
                    {languageLabel(
                      content.language,
                    )}
                  </>
                )
              }

              {
                content.elsewhere && (
                  <>
                    {" · "}
                    Elsewhere ↗
                  </>
                )
              }
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : showEmpty ? (
    <p class="muted">
      No public contents yet.
    </p>
  ) : null
}
