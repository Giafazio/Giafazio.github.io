---
import { siteConfig } from "../data/site";
import { routeFor, withBase } from "../lib/urls";

const { welcome } = siteConfig;

// Entrambe le lingue usano la stessa struttura e gli stessi sette livelli.
const parseMessages = (texts: readonly string[]) => texts.map(
  (rawText, level) => {
    const paragraphs = rawText
      .trim()
      .split(/\r?\n\s*\r?\n/);

    if (paragraphs.length !== 2) {
      throw new Error(
        `Welcome enthusiasm level ${level} must contain exactly two paragraphs.`,
      );
    }

    const nameParts = paragraphs[0].split("{name}");

    if (nameParts.length !== 2) {
      throw new Error(
        `Welcome enthusiasm level ${level} must contain exactly one {name} marker.`,
      );
    }

    const afterName = nameParts[1].trimStart();

    /*
     * Separa la punteggiatura conclusiva del
     * greeting dal resto del primo capoverso.
     *
     * Esempio:
     * "! Tinkerer by inclination..."
     *
     * diventa:
     * greetingPunctuation: "!"
     * firstParagraph: "Tinkerer by inclination..."
     */
    const greetingMatch = afterName.match(
      /^([.!?]+)\s*([\s\S]+)$/,
    );

    if (!greetingMatch) {
      throw new Error(
        `Welcome enthusiasm level ${level} must contain text after the greeting.`,
      );
    }

    const beforeName = nameParts[0].trimEnd();
    // Il maiuscoletto riguarda solo questi saluti, non il successivo "sono/I am".
    const smallCapsGreeting = beforeName.match(/^(Hello World!|Ciao a Tutti!)/)?.[0] ?? "";

    return {
      smallCapsGreeting,
      beforeName: beforeName.slice(smallCapsGreeting.length),
      greetingPunctuation: greetingMatch[1],
      firstParagraph: greetingMatch[2].trim(),
      secondParagraph: paragraphs[1].trim(),
    };
  },
);

const messagesByLanguage = {
  en: parseMessages(welcome.enthusiasmTexts),
  it: parseMessages(welcome.enthusiasmTextsIt),
};

if (Object.values(messagesByLanguage).some((messages) => messages.length !== 7)) {
  throw new Error("Each Welcome language must contain exactly seven levels.");
}

const initialLevel = welcome.defaultEnthusiasm;
const initialMessage = messagesByLanguage.en[initialLevel];
const maxLevel = messagesByLanguage.en.length - 1;

const nameHref = withBase(
  routeFor("fieldNotes", "aggiungi-titolo"),
);
---

<div
  class="welcome-intro"
  data-welcome-intro
  data-welcome-messages={JSON.stringify(messagesByLanguage)}
>
  <fieldset
    class="welcome-language"
    data-welcome-language-selector
    hidden
  >
    <legend class="visually-hidden">
      <span lang="it">Lingua</span> /
      <span lang="en">Language</span>
    </legend>

    <label lang="it">
      <input
        class="visually-hidden"
        type="radio"
        name="welcome-language"
        value="it"
        aria-label="Italiano"
        data-welcome-language
      />
      <span>ita</span>
    </label>

    <label lang="en">
      <input
        class="visually-hidden"
        type="radio"
        name="welcome-language"
        value="en"
        aria-label="English"
        data-welcome-language
        checked
      />
      <span>eng</span>
    </label>
  </fieldset>

  <div class="welcome-panel__topline">
    <header class="welcome-panel__label">
      <h1 id="welcome-title">
        <span class="welcome-panel__title" data-welcome-it="Benvenuti!">
          Welcome!
        </span>

        <span class="welcome-panel__subtitle" data-welcome-it="L'Ingresso">
          The Entrance
        </span>
      </h1>
    </header>

    <p class="welcome-copy__greeting">
      <span
        class="welcome-copy__greeting-small-caps"
        data-welcome-small-caps
      >{initialMessage.smallCapsGreeting}</span><span data-welcome-before>
        {initialMessage.beforeName}{" "}
      </span>

      <a
        class="welcome-name"
        href={nameHref}
        title='Leggi "Aggiungi titolo"'
        data-welcome-name
      >
        <span class="visually-hidden">
          Fabrizio
        </span>

        <span
          class="welcome-name__variants"
          aria-hidden="true"
        >
          {
            welcome.nameVariants.map(
              (variant, index) => (
                <span
                  class:list={[
                    "welcome-name__variant",
                    {
                      "is-active":
                        index === 0,
                    },
                  ]}
                  lang={variant.lang}
                  dir={variant.dir}
                  data-welcome-name-variant
                  data-welcome-name-weight={variant.weight}
                >
                  {variant.text}
                </span>
              ),
            )
          }
        </span>
      </a><span
        data-welcome-greeting-punctuation
      >{initialMessage.greetingPunctuation}</span>
    </p>
  </div>

<div class="welcome-copy">
  <!--
    Tutti i testi, in entrambe le lingue, partecipano al calcolo
    dell'altezza: il riquadro resta stabile anche cambiando lingua.
  -->
  <div
    class="welcome-copy__sizer"
    aria-hidden="true"
  >
    {
      Object.entries(messagesByLanguage).flatMap(([language, messages]) =>
        messages.map((message) => (
          <div class="welcome-copy__sizer-message" lang={language}>
            <p class="welcome-copy__paragraph">
              {message.firstParagraph}
            </p>

            <p class="welcome-copy__paragraph">
              {message.secondParagraph}
            </p>
          </div>
        )),
      )
    }
  </div>

  <!-- Unico testo effettivamente visibile -->
  <div class="welcome-copy__active">
    <p
      class="welcome-copy__paragraph"
      data-welcome-first
    >
      {initialMessage.firstParagraph}
    </p>

    <p
      class="welcome-copy__paragraph"
      data-welcome-second
    >
      {initialMessage.secondParagraph}
    </p>
  </div>
</div>

  <div class="welcome-enthusiasm">
     <div
      class="welcome-enthusiasm__bar"
      style={`--enthusiasm-progress: ${
        (initialLevel / maxLevel) * 100
      }%;`}
      data-welcome-enthusiasm-bar
     >
      <input
        id="welcome-enthusiasm-range"
        class="welcome-enthusiasm__range"
        type="range"
        min="0"
        max={maxLevel}
        step="1"
        value={initialLevel}
        aria-valuetext={`Enthusiasm Level ${initialLevel} of ${maxLevel}`}
        data-welcome-enthusiasm
      />
    </div>
    <div class="welcome-enthusiasm__scale">
      <span
        class="welcome-enthusiasm__limit
          welcome-enthusiasm__limit--low"
        data-welcome-it="Basso"
        aria-hidden="true"
      >
        Low
      </span>

      <span
        class="welcome-enthusiasm__limit
          welcome-enthusiasm__limit--high"
        data-welcome-it="Alto"
        aria-hidden="true"
      >
        High
      </span>

      <label
        class="welcome-enthusiasm__label"
        for="welcome-enthusiasm-range"
      >
        <strong
          class="welcome-enthusiasm__arrow"
          aria-hidden="true"
        >
          ⇐
        </strong>

        <span data-welcome-it="Grado di Entusiasmo">Enthusiasm Level</span>

        <span aria-hidden="true">⇒</span>
      </label>
    </div>

    <output
      class="visually-hidden"
      for="welcome-enthusiasm-range"
      data-welcome-output
    >
      Enthusiasm Level {initialLevel} of {maxLevel}
    </output>
  </div>
</div>

<script>
  type WelcomeMessage = {
    smallCapsGreeting: string;
    beforeName: string;
    greetingPunctuation: string;
    firstParagraph: string;
    secondParagraph: string;
  };

  type WelcomeIntroElements = {
    root: HTMLElement;
    smallCapsGreeting: HTMLElement;
    beforeName: HTMLElement;
    greetingPunctuation: HTMLElement;
    firstParagraph: HTMLElement;
    secondParagraph: HTMLElement;
    enthusiasmBar: HTMLElement;
    range: HTMLInputElement;
    output: HTMLOutputElement | null;
    panel: HTMLElement;
    languageSelector: HTMLFieldSetElement | null;
    languageInputs: NodeListOf<HTMLInputElement>;
    translatedLabels: Array<{
      element: HTMLElement;
      en: string;
      it: string;
    }>;
    nameVariants: HTMLElement[];
  };

  const getWelcomeIntroElements = (
    root: HTMLElement,
  ): WelcomeIntroElements | null => {
    const messagesData =
      root.dataset.welcomeMessages;

    if (!messagesData) {
      return null;
    }

    const smallCapsGreeting =
      root.querySelector<HTMLElement>(
        "[data-welcome-small-caps]",
      );

    const beforeName =
      root.querySelector<HTMLElement>(
        "[data-welcome-before]",
      );

    const greetingPunctuation =
      root.querySelector<HTMLElement>(
        "[data-welcome-greeting-punctuation]",
      );

    const firstParagraph =
      root.querySelector<HTMLElement>(
        "[data-welcome-first]",
      );

    const secondParagraph =
      root.querySelector<HTMLElement>(
        "[data-welcome-second]",
      );

    const enthusiasmBar =
      root.querySelector<HTMLElement>(
        "[data-welcome-enthusiasm-bar]",
      );

    const range =
      root.querySelector<HTMLInputElement>(
        "[data-welcome-enthusiasm]",
      );

    const output =
      root.querySelector<HTMLOutputElement>(
        "[data-welcome-output]",
      );

    const panel =
      root.closest<HTMLElement>(".welcome-panel") ??
      root;

    const languageSelector =
      root.querySelector<HTMLFieldSetElement>(
        "[data-welcome-language-selector]",
      );

    const languageInputs =
      root.querySelectorAll<HTMLInputElement>(
        "[data-welcome-language]",
      );

    if (
      !smallCapsGreeting ||
      !beforeName ||
      !greetingPunctuation ||
      !firstParagraph ||
      !secondParagraph ||
      !enthusiasmBar ||
      !range
    ) {
      return null;
    }

    const translatedLabels = Array.from(
      panel.querySelectorAll<HTMLElement>(
        "[data-welcome-it]",
      ),
      (element) => ({
        element,
        en: element.textContent?.trim() ?? "",
        it: element.dataset.welcomeIt ?? "",
      }),
    );

    const nameVariants = Array.from(
      root.querySelectorAll<HTMLElement>(
        "[data-welcome-name-variant]",
      ),
    );

    return {
      root,
      smallCapsGreeting,
      beforeName,
      greetingPunctuation,
      firstParagraph,
      secondParagraph,
      enthusiasmBar,
      range,
      output,
      panel,
      languageSelector,
      languageInputs,
      translatedLabels,
      nameVariants,
    };
  };

  const createWelcomeIntroState = (
    messagesByLanguage: Record<"it" | "en", WelcomeMessage[]>,
    elements: WelcomeIntroElements,
  ) => {
    let welcomeLanguage: "it" | "en" = "en";

    const setWelcomeLanguage = (
      language: "it" | "en",
    ) => {
      welcomeLanguage = language;
      elements.root.lang = language;
      elements.panel.dataset.welcomeLanguage = language;
    };

    const render = (requestedLevel: number) => {
      const messages = messagesByLanguage[welcomeLanguage];
      const level = Math.max(
        0,
        Math.min(
          messages.length - 1,
          Math.round(requestedLevel),
        ),
      );
      const message = messages[level];

      elements.smallCapsGreeting.textContent =
        message.smallCapsGreeting;
      elements.beforeName.textContent =
        `${message.beforeName} `;
      elements.greetingPunctuation.textContent =
        message.greetingPunctuation;
      elements.firstParagraph.textContent =
        message.firstParagraph;
      elements.secondParagraph.textContent =
        message.secondParagraph;
      elements.range.value = String(level);

      const progress =
        messages.length > 1
          ? (level / (messages.length - 1)) * 100
          : 0;

      elements.enthusiasmBar.style.setProperty(
        "--enthusiasm-progress",
        `${progress}%`,
      );

      const valueText = welcomeLanguage === "it"
        ? `Grado di Entusiasmo ${level} di ${messages.length - 1}`
        : `Enthusiasm Level ${level} of ${messages.length - 1}`;

      elements.range.lang = welcomeLanguage;
      elements.range.setAttribute(
        "aria-valuetext",
        valueText,
      );

      if (elements.output) {
        elements.output.lang = welcomeLanguage;
        elements.output.textContent = valueText;
      }
    };

    const applyLanguage = (language: "it" | "en") => {
      setWelcomeLanguage(language);

      elements.translatedLabels.forEach((label) => {
        label.element.textContent = label[language];
        label.element.lang = language;
      });

      elements.languageInputs.forEach((input) => {
        input.checked = input.value === language;
      });

      render(elements.range.valueAsNumber);
      elements.panel.dispatchEvent(
        new Event("welcome:language-change"),
      );
    };

    return {
      setWelcomeLanguage: applyLanguage,
      renderMessage: render,
      get language() {
        return welcomeLanguage;
      },
    };
  };

  const warmNameFonts = (
    elements: WelcomeIntroElements,
  ) => {
    const fontRequests = elements.nameVariants.flatMap(
      (variant) => {
        const sample = variant.textContent?.trim();

        if (!sample) {
          return [];
        }

        const style = getComputedStyle(variant);

        return [
          document.fonts.load(
            `${style.fontStyle} ${style.fontWeight} 1em ${style.fontFamily}`,
            sample,
          ),
        ];
      },
    );

    void Promise.allSettled(fontRequests);
  };

  const createNameRotation = (
    elements: WelcomeIntroElements,
    root: HTMLElement,
  ) => {
    const nameWeights = elements.nameVariants.map(
      (variant) => {
        const weight = Number(
          variant.dataset.welcomeNameWeight,
        );

        return Number.isFinite(weight) &&
          weight > 0
          ? weight
          : 0;
      },
    );

    const totalNameWeight = nameWeights.reduce(
      (total, weight) => total + weight,
      0,
    );

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

    if (
      elements.nameVariants.length <= 1 ||
      totalNameWeight <= 0 ||
      reducedMotion
    ) {
      return;
    }

    const chooseWeightedName = () => {
      let draw = Math.random() * totalNameWeight;

      for (
        let index = 0;
        index < nameWeights.length;
        index += 1
      ) {
        draw -= nameWeights[index];

        if (draw < 0) {
          return index;
        }
      }

      return Math.max(
        0,
        elements.nameVariants.length - 1,
      );
    };

    const showName = (index: number) => {
      elements.nameVariants.forEach(
        (variant, variantIndex) => {
          variant.classList.toggle(
            "is-active",
            variantIndex === index,
          );
        },
      );
    };

    const intervalId = window.setInterval(() => {
      showName(chooseWeightedName());
    }, 3000);

    root.dataset.welcomeNameInterval =
      String(intervalId);
  };

  const initializeWelcomeIntro = (
    root: HTMLElement,
  ) => {
    const messagesData = JSON.parse(
      root.dataset.welcomeMessages ?? "{}",
    ) as Record<"it" | "en", WelcomeMessage[]>;

    const elements = getWelcomeIntroElements(root);

    if (!elements) {
      return;
    }

    const state = createWelcomeIntroState(
      messagesData,
      elements,
    );

    elements.languageInputs.forEach((input) => {
      input.addEventListener("change", () => {
        if (
          input.checked &&
          (input.value === "it" || input.value === "en")
        ) {
          state.setWelcomeLanguage(input.value);
        }
      });
    });

    elements.range.addEventListener("input", () => {
      state.renderMessage(
        elements.range.valueAsNumber,
      );
    });

    if (typeof window.requestIdleCallback === "function") {
      window.requestIdleCallback(() => {
        void warmNameFonts(elements);
      }, { timeout: 1200 });
    } else {
      window.setTimeout(() => {
        void warmNameFonts(elements);
      }, 250);
    }

    createNameRotation(elements, root);

    state.setWelcomeLanguage("en");

    if (elements.languageSelector) {
      elements.languageSelector.hidden = false;
    }
  };

  const clearWelcomeNameIntervals = () => {
    document
      .querySelectorAll<HTMLElement>(
        "[data-welcome-name-interval]",
      )
      .forEach((root) => {
        const intervalId = Number(
          root.dataset.welcomeNameInterval,
        );

        if (Number.isFinite(intervalId)) {
          window.clearInterval(intervalId);
        }

        delete root.dataset.welcomeNameInterval;
      });
  };

  window.fabrizioWebhome?.initOnAstroLoad?.({
    selector: "[data-welcome-intro]",
    initializedAttribute: "welcomeInitialized",
    initializer: initializeWelcomeIntro,
    onBeforeSwap: clearWelcomeNameIntervals,
  });
</script>
