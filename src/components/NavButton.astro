---
import type { SiteSection } from "../data/site";

interface Props {
  label: string;
  href: string;
  section: SiteSection;
  active: boolean;
  baseBackground?: string;
}

const {
  label,
  href,
  section,
  active,
  baseBackground,
} = Astro.props;

---

<a
  class="nav-button"
  href={href}
  data-nav-button
  data-section={section}
  aria-current={active ? "page" : undefined}
>
  <span
    class="nav-button__base"
    data-nav-button-base
    aria-hidden="true"
    style={baseBackground
      ? `--nav-tile-image: url("${baseBackground}")`
      : undefined}
  ></span>

  <span
    class="nav-button__overlay"
    aria-hidden="true"
  ></span>

  <span class="nav-button__label">
    {label}
  </span>
</a>

<style>

  .nav-button {
    position: relative;
    display: inline-grid;
    place-items: center;

    /*
    * In una riga flex il tasto parte dalla propria
    * larghezza naturale, determinata dal testo.
    */
    flex: 0 0 auto;

    min-width: 0;
    min-height: 64px;
    padding: 6px 16px;

    box-sizing: border-box;

    border: 4px solid #5a3b26;

    color: var(--nav-label-color, #ffffff);
    text-decoration: none;
    white-space: nowrap;

    transform: translateY(0);
    overflow: hidden;
  }

  .nav-button:visited {
   color: var(--nav-label-color, #ffffff);
  }

  .nav-button__base,
  .nav-button__overlay {
    position: absolute;
    inset: 0;

    pointer-events: none;
  }

  .nav-button__overlay {
    z-index: 1;
    background: rgb(0 0 0 / 0.16);
  }

  .nav-button__base {
    z-index: 0;

    /*
    * Il livello è più alto del tasto di una tile.
    * In questo modo può traslare verso l'alto
    * senza lasciare uno spazio vuoto sotto.
    */
    inset: 0 0 calc(-1 * var(--motion-tile-size)) 0;

    background-color: #ffffff;

    background-image:
      linear-gradient(
        to right,
        transparent 0,
        transparent var(--motion-tile-inner-end),
        #ffffff var(--motion-tile-inner-end),
        #ffffff var(--motion-tile-size)
      ),
      linear-gradient(
        to bottom,
        transparent 0,
        transparent var(--motion-tile-inner-end),
        #ffffff var(--motion-tile-inner-end),
        #ffffff var(--motion-tile-size)
      ),
      var(--nav-tile-image, none);

    background-repeat: repeat;

    background-size:
      var(--motion-tile-size)
      var(--motion-tile-size);

    background-position: center center;

    image-rendering: crisp-edges;
    image-rendering: pixelated;

    animation:
      nav-button-background-rise
      var(--motion-tile-duration)
      linear
      infinite;

    animation-play-state: paused;
    will-change: transform;
  }

  @keyframes nav-button-background-rise {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform:
        translate3d(0, var(--motion-tile-shift), 0);
    }
  }

  .nav-button:active {
    transform:
      translateY(var(--nav-button-press-depth, 2px));
  }

  .nav-button__label {
    position: relative;
    z-index: 3;

    font-family: "Basteleur", serif;
    font-weight: normal;
    font-size: 28px;
    line-height: 1;

    -webkit-text-stroke: 6px rgb(0 0 0 / 0.95);
    paint-order: stroke fill;
    text-shadow: none;
  }

  @media (max-width: 700px) {
    .nav-button {
      min-height: 30px;
      border-width: 3px;
      padding: 3px 6px;
    }

    .nav-button__label {
      font-size: clamp(14px, 4.25vw, 22px);
      -webkit-text-stroke-width: 3px;
    }
  }

</style>

<script>
  import { initializeTileMotion } from "../lib/tile-motion";

  const initializeNavTileMotion = () => {
    document.querySelectorAll<HTMLElement>("[data-nav-button]").forEach((button) => {
      const base = button.querySelector<HTMLElement>("[data-nav-button-base]");
      if (base) initializeTileMotion(button, { getAnimation: () => base.getAnimations()[0] });
    });
  };

  initializeNavTileMotion();
  document.addEventListener("astro:page-load", initializeNavTileMotion);
</script>
