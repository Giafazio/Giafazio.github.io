---
import { getImage } from "astro:assets";
import { headerBackgroundSources } from "../data/header-backgrounds";
import headerBackgroundScript from "../lib/header-background.js?raw";
import NavButton from "./NavButton.astro";
import NavigationCrow from "./NavigationCrow.astro";
import maio1Tile from "../assets/navigation/tiles/maio1.png";
import maio2Tile from "../assets/navigation/tiles/maio2.png";
import HeaderWordmark from "../assets/header/HandWrittenHeaderFabriziosWebhome.svg";
import { navigation, siteConfig, type SiteSection } from "../data/site";
import { withBase } from "../lib/urls";

interface Props {
  currentSection?: SiteSection;
}
const { currentSection } = Astro.props;
const navigationRows = [
  navigation.slice(0, 3),
  navigation.slice(3),
];

const headerBackgrounds = await Promise.all(headerBackgroundSources.map(async ({ source, position, desktopPosition }) => {
  // I nuovi WebP sono già ottimizzati: evitiamo una seconda compressione.
  const optimizedImage = source.format === "webp"
    ? source
    : await getImage({
      src: source,
      width: Math.min(source.width, 1600),
      format: "webp",
      quality: 80,
    });
  return {
    src: optimizedImage.src,
    position,
    desktopPosition: desktopPosition ?? position,
  };
}));

const defaultHeaderBackground = headerBackgrounds[2];
if (!defaultHeaderBackground) {
  throw new Error("The default header background is missing.");
}

const getBaseBackground = (section: SiteSection) => {
  switch (section) {
    case "home":
      return maio1Tile.src;
    case "field-notes":
      return maio2Tile.src;
    case "projects":
      return maio1Tile.src;
    case "experiments":
      return maio2Tile.src;
    case "atlas":
      return maio1Tile.src;
  }
};

---

<header
  class="webhome-header"
  data-header-backgrounds={JSON.stringify(
    headerBackgrounds,
  )}
  style={`
    --header-background:
      url("${defaultHeaderBackground.src}");
    --header-background-position:
      ${defaultHeaderBackground.position};
    --header-background-desktop-position:
      ${defaultHeaderBackground.desktopPosition};
  `}
>
  <script is:inline set:html={headerBackgroundScript} />
  <div
    class="webhome-header__banner"
    data-header-banner
  >
    <div
      class="webhome-header__background-track"
      data-header-background-track
      aria-hidden="true"
    >
      <div
        class="webhome-header__background-image"
        data-header-background-image
      ></div>
    </div>
    <a
      class="webhome-header__title"
      href={withBase("/")}
      aria-label={siteConfig.headerTitle}
    >
      <HeaderWordmark
        class="webhome-header__wordmark"
        aria-hidden="true"
        focusable="false"
      />
    </a>
  </div>

  <nav
    class="webhome-nav"
    aria-label="Main navigation"
    data-crow-navigation
  >
    <div class="webhome-nav__buttons">
      {
        navigationRows.map((row) => (
          <div class="webhome-nav__row">
            {row.map((item) => (
              <NavButton
                label={item.shortLabel}
                href={withBase(item.href)}
                section={item.section}
                active={item.section === currentSection}
                baseBackground={getBaseBackground(item.section)}
              />
            ))}
          </div>
        ))
      }
    </div>

    <NavigationCrow />
  </nav>

</header>

<style>
  .webhome-header {
    position: relative;

    --nav-button-press-depth: 2px;
    --wordmark-fill: #ffffff;
    --wordmark-outline: #000000;
    --nav-label-color: #ffffff;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;

    gap: 0;
  }

  .webhome-header__banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--paper-raised);

    display: grid;
    align-items: center;
    justify-items: start;

    min-width: 0;
    min-height: 180px;

    padding: 36px;

    border: 7px solid var(--frame-main);

    box-shadow:
      0 0 0 2px var(--frame-dark);
  }

  .webhome-header__background-track {
    position: absolute;
    inset: -36px 0;
    z-index: 0;

    pointer-events: none;

    transform:
      translate3d(
        0,
        var(--header-parallax-y, 0px),
        0
      );

    will-change: transform;
  }

  .webhome-header__background-image {
    position: absolute;
    inset: -4px;

    background-image: var(--header-background);
    background-size: cover;
    background-position:
      var(
        --header-background-position,
        center
      );
    background-repeat: no-repeat;

    transform-origin: center;
    will-change: transform;
  }

  /*
  * Ricostruiamo il sottile bordo interno sopra
  * l'immagine mobile.
  */
  .webhome-header__banner::after {
    position: absolute;
    inset: 0;
    z-index: 2;

    box-shadow:
      inset 0 0 0 2px var(--frame-highlight);

    content: "";
    pointer-events: none;
  }

  .webhome-header__title {
    position: relative;
    z-index: 1;
    display: block;
    width: clamp(180px, 24vw, 360px);
    max-width: 100%;

    color: var(--wordmark-fill);
    line-height: 0;
    text-decoration: none;

    transform: translateY(0);
  }

  .webhome-header__title:visited {
    color: var(--wordmark-fill);
  }

  .webhome-header__title:hover {
    text-decoration: none;
  }

  .webhome-header__title:active {
    transform:
      translateY(var(--nav-button-press-depth, 2px));
  }

  :global(.webhome-header__wordmark) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  :global(.webhome-header__wordmark path) {
    fill: currentColor;

    stroke: var(--wordmark-outline);
    stroke-width: 5px;
    stroke-linecap: round;
    stroke-linejoin: round;

    paint-order: stroke fill;
    vector-effect: non-scaling-stroke;
  }

  .webhome-nav {
    position: relative;

    width: 100%;
    min-width: 0;

    /*
    * Zona riservata al corvo posato
    * sul bordo superiore dei tasti.
    */
    padding-top: 52px;

    overflow: visible;
  }

  /* Con JavaScript mostriamo solo il layout misurato con il font del menù. */
  :global(.has-js) .webhome-nav:not([data-navigation-layout-ready]) {
    visibility: hidden;
  }

  .webhome-nav__buttons {
    display: flex;
    flex-flow: row nowrap;
    justify-content: center;
    align-items: stretch;

    gap: 4px;

    width: 100%;
    margin-inline: auto;

  }

  .webhome-nav__row {
    display: contents;
  }

  .webhome-nav--two-rows
  .webhome-nav__buttons {
    display: flex;
    flex-direction: column;
    align-items: center;

    gap: 48px;
  }

  .webhome-nav--two-rows
  .webhome-nav__row {
    display: flex;
    justify-content: center;
    align-items: stretch;

    gap: 2px;
  }

  @media (min-width: 701px) {
    .webhome-header__background-image {
      background-position:
        var(--header-background-desktop-position,
          var(--header-background-position, center));
    }
  }

  @media (max-width: 700px) {
    /* Riserva fin dal primo render le due righe usate sui telefoni. */
    .webhome-nav:not([data-navigation-layout-ready]) .webhome-nav__buttons {
      flex-direction: column;
      align-items: center;
      gap: 48px;
    }

    .webhome-nav:not([data-navigation-layout-ready]) .webhome-nav__row {
      display: flex;
      justify-content: center;
      align-items: stretch;
      gap: 2px;
    }

    .webhome-header__banner {
      min-height: 140px;
      padding: 12px;
      border-width: 3px;

      box-shadow:
        0 0 0 1px var(--frame-dark);
    }

    .webhome-header__banner::after {
      box-shadow:
        inset 0 0 0 1px
          var(--frame-highlight);
    }

    .webhome-header__title {
      width: min(100%, 360px);
    }
  }

  @media (
    max-width: 700px
  ) and (
    pointer: coarse
  ) {
    .webhome-nav:not([data-navigation-layout-ready]) .webhome-nav__buttons,
    .webhome-nav--two-rows
    .webhome-nav__buttons {
      gap: 29px;
    }
  }
</style>

<script>
  import "../lib/site-header";
</script>
