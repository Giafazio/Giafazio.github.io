---
import MusicPiece from "./MusicPiece.astro";
import type { ArtifactEntry, ProjectEntry, PublishableEntry } from "../lib/content";
import tile from "../assets/navigation/tiles/maio1_4.png";
interface Props {
  projects: readonly ProjectEntry[];
  project: ProjectEntry; entries: PublishableEntry[]; showHeadings?: boolean; }
const { projects, project, entries, showHeadings = true } = Astro.props;
const tracks = entries.filter((entry): entry is ArtifactEntry => entry.collection === "artifacts" && entry.data.artifactKind === "audio");
// Do not silently omit a piece when its project section is missing.
for (const track of tracks) {
  const relation = track.data.projects.find(relation => relation.id === project.data.id);
  if (!relation?.group) {
    throw new Error(
      `Music piece "${track.data.id}" must specify a content group ` +
      `in project "${project.data.id}".`,
    );
  }
}
---
{project.data.contentGroups.map(group => <section class="project-content-section" aria-label={group.title}>
  {showHeadings && <h2 class="project-page-section-title">{group.title}</h2>}
  {tracks.filter(track => track.data.projects.some(relation => relation.id === project.data.id && relation.group === group.id)).map(artifact => <MusicPiece projects={projects} artifact={artifact} tile={tile.src} />)}
</section>)}
