---
import HomeFeaturedCard from
  "./HomeFeaturedCard.astro";

import type {
  HomeFeaturedItem,
} from "../lib/homeFeatured";

interface Props {
  items: HomeFeaturedItem[];
}

type GallerySlide = {
  kind:
    | "project"
    | "artifacts"
    | "entry";

  items: HomeFeaturedItem[];
};

const { items } = Astro.props;

const slides: GallerySlide[] = [];

for (const item of items) {
  const isArtifact =
    item.kind === "entry" &&
    item.entry.collection === "artifacts";

  if (isArtifact) {
    const previousSlide =
      slides[slides.length - 1];

    if (
      previousSlide?.kind === "artifacts" &&
      previousSlide.items.length < 2
    ) {
      previousSlide.items.push(item);
      continue;
    }

    slides.push({
      kind: "artifacts",
      items: [item],
    });

    continue;
  }

  slides.push({
    kind: item.kind,
    items: [item],
  });
}
---

<div
  class="home-featured-gallery-shell"
  data-home-featured-gallery
>
  {
    slides.length > 1 && (
      <button
        class="
          home-featured-gallery__button
          home-featured-gallery__button--previous
        "
        type="button"
        aria-label="Previous featured contents"
        aria-controls="home-featured-gallery-track"
        data-gallery-previous
        disabled
      >
        ←
      </button>
    )
  }

  <ul
    id="home-featured-gallery-track"
    class="home-featured-gallery"
    tabindex="0"
    aria-label="Featured contents gallery"
    data-gallery-track
  >
    {
      slides.map((slide) => (
        <li
          class:list={[
            "home-featured-slide",
            `home-featured-slide--${slide.kind}`,
          ]}
          data-count={slide.items.length}
        >
          {
            slide.items.map((item) => (
              <div
                class:list={[
                  "home-featured-slide__item",
                  "home-featured-item",
                  `home-featured-item--${item.kind}`,
                ]}
              >
                <HomeFeaturedCard item={item} />
              </div>
            ))
          }
        </li>
      ))
    }
  </ul>

  {
    slides.length > 1 && (
      <button
        class="
          home-featured-gallery__button
          home-featured-gallery__button--next
        "
        type="button"
        aria-label="Next featured contents"
        aria-controls="home-featured-gallery-track"
        data-gallery-next
      >
        →
      </button>
    )
  }
  {
    slides.length > 1 && (
      <div
        class="home-featured-gallery__scroll-control"
      >
        <div
          class="home-featured-gallery__scrollbar"
          style="--gallery-fill: 9px;"
          data-gallery-scrollbar
        >
          <input
            id="home-featured-gallery-range"
            class="home-featured-gallery__range"
            type="range"
            min="0"
            max="100"
            step="0.1"
            value="0"
            aria-label="Browse the Gallery"
            aria-controls="home-featured-gallery-track"
            aria-valuetext="Beginning of the gallery"
            data-gallery-range
          />
        </div>

        <label
          class="home-featured-gallery__range-label"
          for="home-featured-gallery-range"
        >
          <strong aria-hidden="true">⇐</strong>
          <span>Browse the Gallery</span>
          <strong aria-hidden="true">⇒</strong>
        </label>
      </div>
    )
  }
</div>

<script>
  type GalleryMetrics = {
    track: HTMLElement;
    previousButton: HTMLButtonElement | null;
    nextButton: HTMLButtonElement | null;
    range: HTMLInputElement;
    scrollbar: HTMLElement | null;
  };

  type GalleryState = {
    snapTimer?: number;
    rangeIsActive: boolean;
    metrics: GalleryMetrics;
  };

  const buildGalleryState = (
    root: HTMLElement,
  ): GalleryState | null => {
    const track =
      root.querySelector<HTMLElement>(
        "[data-gallery-track]",
      );

    const range =
      root.querySelector<HTMLInputElement>(
        "[data-gallery-range]",
      );

    if (!track || !range) {
      return null;
    }

    const previousButton =
      root.querySelector<HTMLButtonElement>(
        "[data-gallery-previous]",
      );

    const nextButton =
      root.querySelector<HTMLButtonElement>(
        "[data-gallery-next]",
      );

    const scrollbar =
      root.querySelector<HTMLElement>(
        "[data-gallery-scrollbar]",
      );

    return {
      snapTimer: undefined,
      rangeIsActive: false,
      metrics: {
        track,
        previousButton,
        nextButton,
        range,
        scrollbar,
      },
    };
  };

  const computeMaximumScroll = (
    track: HTMLElement,
  ) =>
    Math.max(
      0,
      track.scrollWidth - track.clientWidth,
    );

  const computeSlideStep = (
    track: HTMLElement,
  ) => {
    const firstSlide =
      track.querySelector<HTMLElement>(
        ".home-featured-slide",
      );

    if (!firstSlide) {
      return track.clientWidth;
    }

    const gap =
      Number.parseFloat(
        getComputedStyle(track).columnGap,
      ) || 0;

    return (
      firstSlide.getBoundingClientRect().width +
      gap
    );
  };

  const computeNearestSnapPosition = (
    track: HTMLElement,
  ) => {
    const maximumScroll = computeMaximumScroll(track);
    const slideStep = computeSlideStep(track);

    if (slideStep <= 0) {
      return 0;
    }

    return Math.min(
      maximumScroll,
      Math.max(
        0,
        Math.round(track.scrollLeft / slideStep) *
          slideStep,
      ),
    );
  };

  const renderGalleryFill = (
    scrollbar: HTMLElement | null,
    progress: number,
  ) => {
    if (!scrollbar) {
      return;
    }

    const thumbRadius = 9;
    const availableWidth = Math.max(
      0,
      scrollbar.clientWidth - thumbRadius * 2,
    );
    const fill =
      thumbRadius + availableWidth * progress;

    scrollbar.style.setProperty(
      "--gallery-fill",
      `${fill}px`,
    );
  };

  const syncControls = (
    state: GalleryState,
  ) => {
    const { track, previousButton, nextButton, range, scrollbar } =
      state.metrics;

    const maximumScroll =
      computeMaximumScroll(track);

    const progress =
      maximumScroll > 0
        ? Math.min(
            1,
            Math.max(0, track.scrollLeft / maximumScroll),
          )
        : 0;

    const percentage = progress * 100;

    range.value = percentage.toFixed(1);
    range.setAttribute(
      "aria-valuetext",
      `Gallery position: ${Math.round(percentage)}%`,
    );

    if (previousButton) {
      previousButton.disabled = track.scrollLeft <= 1;
    }

    if (nextButton) {
      nextButton.disabled =
        track.scrollLeft >= maximumScroll - 1;
    }

    renderGalleryFill(scrollbar, progress);
  };

  const snapToNearestPosition = (
    state: GalleryState,
  ) => {
    if (state.rangeIsActive) {
      return;
    }

    const targetPosition =
      computeNearestSnapPosition(state.metrics.track);

    if (
      Math.abs(
        targetPosition -
          state.metrics.track.scrollLeft,
      ) <= 1
    ) {
      return;
    }

    state.metrics.track.scrollTo({
      left: targetPosition,
      behavior: "smooth",
    });
  };

  const scheduleSnap = (state: GalleryState) => {
    window.clearTimeout(state.snapTimer);

    if (state.rangeIsActive) {
      return;
    }

    state.snapTimer = window.setTimeout(() => {
      snapToNearestPosition(state);
    }, 180);
  };

  const initializeFeaturedGalleries = (root: HTMLElement) => {
    const state = buildGalleryState(root);

    if (!state) {
      return;
    }

    const { metrics } = state;
    const { range, track, previousButton, nextButton } = metrics;

    const onRangePointerDown = () => {
      state.rangeIsActive = true;
      window.clearTimeout(state.snapTimer);
    };

    const finishRangeInteraction = () => {
      state.rangeIsActive = false;
      window.clearTimeout(state.snapTimer);
      snapToNearestPosition(state);
    };

    range.addEventListener(
      "pointerdown",
      onRangePointerDown,
      { passive: true },
    );

    range.addEventListener(
      "pointerup",
      finishRangeInteraction,
      { passive: true },
    );

    range.addEventListener(
      "pointercancel",
      finishRangeInteraction,
      { passive: true },
    );

    range.addEventListener(
      "change",
      finishRangeInteraction,
    );

    range.addEventListener("input", () => {
      const progress = range.valueAsNumber / 100;
      metrics.track.scrollLeft =
        computeMaximumScroll(track) * progress;
      renderGalleryFill(metrics.scrollbar, progress);
    });

    previousButton?.addEventListener("click", () => {
      track.scrollBy({
        left: -computeSlideStep(track),
        behavior: "smooth",
      });
    });

    nextButton?.addEventListener("click", () => {
      track.scrollBy({
        left: computeSlideStep(track),
        behavior: "smooth",
      });
    });

    track.addEventListener(
      "scroll",
      () => {
        syncControls(state);
        scheduleSnap(state);
      },
      { passive: true },
    );

    const resizeObserver = new ResizeObserver(() => {
      syncControls(state);
    });

    resizeObserver.observe(track);

    const cleanup = () => {
      resizeObserver.disconnect();
      window.clearTimeout(state.snapTimer);
    };

    document.addEventListener("astro:before-swap", cleanup, {
      once: true,
    });

    syncControls(state);
  };

  window.fabrizioWebhome?.initOnAstroLoad?.({
    selector: "[data-home-featured-gallery]",
    initializedAttribute: "galleryInitialized",
    initializer: initializeFeaturedGalleries,
  });
</script>
