---
import HomeFeaturedCard from
  "./HomeFeaturedCard.astro";

import type {
  HomeFeaturedItem,
} from "../lib/homeFeatured";

interface Props {
  items: HomeFeaturedItem[];
}

type GallerySlide = {
  kind:
    | "project"
    | "artifacts"
    | "entry";

  items: HomeFeaturedItem[];
};

const { items } = Astro.props;

const slides: GallerySlide[] = [];

for (const item of items) {
  const isArtifact =
    item.kind === "entry" &&
    item.entry.collection === "artifacts";

  if (isArtifact) {
    const previousSlide =
      slides[slides.length - 1];

    if (
      previousSlide?.kind === "artifacts" &&
      previousSlide.items.length < 2
    ) {
      previousSlide.items.push(item);
      continue;
    }

    slides.push({
      kind: "artifacts",
      items: [item],
    });

    continue;
  }

  slides.push({
    kind: item.kind,
    items: [item],
  });
}
---

<div
  class="home-featured-gallery-shell"
  data-home-featured-gallery
>
  {
    slides.length > 1 && (
      <button
        class="
          home-featured-gallery__button
          home-featured-gallery__button--previous
        "
        type="button"
        aria-label="Previous featured contents"
        aria-controls="home-featured-gallery-track"
        data-gallery-previous
        disabled
      >
        ←
      </button>
    )
  }

  <ul
    id="home-featured-gallery-track"
    class="home-featured-gallery"
    tabindex="0"
    aria-label="Featured contents gallery"
    data-gallery-track
  >
    {
      slides.map((slide) => (
        <li
          class:list={[
            "home-featured-slide",
            `home-featured-slide--${slide.kind}`,
          ]}
          data-count={slide.items.length}
        >
          {
            slide.items.map((item) => (
              <div
                class:list={[
                  "home-featured-slide__item",
                  "home-featured-item",
                  `home-featured-item--${item.kind}`,
                ]}
              >
                <HomeFeaturedCard item={item} />
              </div>
            ))
          }
        </li>
      ))
    }
  </ul>

  {
    slides.length > 1 && (
      <button
        class="
          home-featured-gallery__button
          home-featured-gallery__button--next
        "
        type="button"
        aria-label="Next featured contents"
        aria-controls="home-featured-gallery-track"
        data-gallery-next
      >
        →
      </button>
    )
  }
  {
    slides.length > 1 && (
      <div
        class="home-featured-gallery__scroll-control"
      >
        <div
          class="home-featured-gallery__scrollbar"
          style="--gallery-fill: 9px;"
          data-gallery-scrollbar
        >
          <input
            id="home-featured-gallery-range"
            class="home-featured-gallery__range"
            type="range"
            min="0"
            max="100"
            step="0.1"
            value="0"
            aria-label="Browse the Gallery"
            aria-controls="home-featured-gallery-track"
            aria-valuetext="Beginning of the gallery"
            data-gallery-range
          />
        </div>

        <label
          class="home-featured-gallery__range-label"
          for="home-featured-gallery-range"
        >
          <strong aria-hidden="true">⇐</strong>
          <span>Browse the Gallery</span>
          <strong aria-hidden="true">⇒</strong>
        </label>
      </div>
    )
  }
</div>

<script>
  const initializeFeaturedGalleries = () => {
    const galleries =
      document.querySelectorAll<HTMLElement>(
        "[data-home-featured-gallery]",
      );

    galleries.forEach((root) => {
      if (
        root.dataset.galleryInitialized ===
        "true"
      ) {
        return;
      }

      const track =
        root.querySelector<HTMLElement>(
          "[data-gallery-track]",
        );

      const previousButton =
        root.querySelector<HTMLButtonElement>(
          "[data-gallery-previous]",
        );

      const nextButton =
        root.querySelector<HTMLButtonElement>(
          "[data-gallery-next]",
        );

      const range =
        root.querySelector<HTMLInputElement>(
          "[data-gallery-range]",
        );

      const scrollbar =
        root.querySelector<HTMLElement>(
          "[data-gallery-scrollbar]",
        );

      if (!track || !range) {
        return;
      }

      const getMaximumScroll = () =>
        Math.max(
          0,
          track.scrollWidth -
            track.clientWidth,
        );

      const getSlideStep = () => {
        const firstSlide =
          track.querySelector<HTMLElement>(
            ".home-featured-slide",
          );

        if (!firstSlide) {
          return track.clientWidth;
        }

        const gap =
          Number.parseFloat(
            getComputedStyle(track)
              .columnGap,
          ) || 0;

        return (
          firstSlide.getBoundingClientRect()
            .width + gap
        );
      };

      let snapTimer:
        number | undefined;

      let rangeIsActive = false;

      const getNearestSnapPosition = () => {
        const maximumScroll =
          getMaximumScroll();

        const slideStep =
          getSlideStep();

        if (slideStep <= 0) {
          return 0;
        }

        return Math.min(
          maximumScroll,
          Math.max(
            0,
            Math.round(
              track.scrollLeft /
                slideStep,
            ) * slideStep,
          ),
        );
      };

      const snapToNearestPosition = () => {
        if (rangeIsActive) {
          return;
        }

        const targetPosition =
          getNearestSnapPosition();

        if (
          Math.abs(
            targetPosition -
              track.scrollLeft,
          ) <= 1
        ) {
          return;
        }

        track.scrollTo({
          left: targetPosition,
          behavior: "smooth",
        });
      };

      const scheduleSnap = () => {
        window.clearTimeout(
          snapTimer,
        );

        if (rangeIsActive) {
          return;
        }

        snapTimer =
          window.setTimeout(
            snapToNearestPosition,
            180,
          );
      };

      const updateFill = (
        progress: number,
      ) => {
        if (!scrollbar) {
          return;
        }

        const thumbRadius = 9;

        const availableWidth =
          Math.max(
            0,
            scrollbar.clientWidth -
              thumbRadius * 2,
          );

        const fill =
          thumbRadius +
          availableWidth * progress;

        scrollbar.style.setProperty(
          "--gallery-fill",
          `${fill}px`,
        );
      };

      const updateControls = () => {
        const maximumScroll =
          getMaximumScroll();

        const progress =
          maximumScroll > 0
            ? Math.min(
                1,
                Math.max(
                  0,
                  track.scrollLeft /
                    maximumScroll,
                ),
              )
            : 0;

        const percentage =
          progress * 100;

        range.value =
          percentage.toFixed(1);

        range.setAttribute(
          "aria-valuetext",
          `Gallery position: ${Math.round(
            percentage,
          )}%`,
        );

        if (previousButton) {
          previousButton.disabled =
            track.scrollLeft <= 1;
        }

        if (nextButton) {
          nextButton.disabled =
            track.scrollLeft >=
            maximumScroll - 1;
        }

        updateFill(progress);
      };

      range.addEventListener(
        "pointerdown",
        () => {
          rangeIsActive = true;

          window.clearTimeout(
            snapTimer,
          );
        },
      );

      const finishRangeInteraction =
        () => {
          rangeIsActive = false;

          window.clearTimeout(
            snapTimer,
          );

          snapToNearestPosition();
        };

      range.addEventListener(
        "pointerup",
        finishRangeInteraction,
      );

      range.addEventListener(
        "pointercancel",
        finishRangeInteraction,
      );

      range.addEventListener(
        "change",
        finishRangeInteraction,
      );

      range.addEventListener(
        "input",
        () => {
          const progress =
            range.valueAsNumber / 100;

          track.scrollLeft =
            getMaximumScroll() *
            progress;

          updateFill(progress);
        },
      );

      previousButton?.addEventListener(
        "click",
        () => {
          track.scrollBy({
            left: -getSlideStep(),
            behavior: "smooth",
          });
        },
      );

      nextButton?.addEventListener(
        "click",
        () => {
          track.scrollBy({
            left: getSlideStep(),
            behavior: "smooth",
          });
        },
      );

      track.addEventListener(
        "scroll",
        () => {
          updateControls();
          scheduleSnap();
        },
        { passive: true },
      );

      const resizeObserver =
        new ResizeObserver(
          updateControls,
        );

      resizeObserver.observe(track);

      document.addEventListener(
        "astro:before-swap",
        () => {
          resizeObserver.disconnect();

          window.clearTimeout(
            snapTimer,
          );
        },
        { once: true },
      );

      updateControls();

      root.dataset.galleryInitialized =
        "true";
    });
  };

  initializeFeaturedGalleries();

  document.addEventListener(
    "astro:page-load",
    initializeFeaturedGalleries,
  );
</script>