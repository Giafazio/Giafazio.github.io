---
import type { CollectionEntry } from "astro:content";
import {
  buildCrosswordModel,
  type CrosswordDirection,
} from "../lib/crosswords";
import { publicAsset } from "../lib/urls";

type ArtifactEntry = CollectionEntry<"artifacts">;
type CrosswordData = NonNullable<ArtifactEntry["data"]["crossword"]>;

interface Props {
  id: string;
  title: string;
  crossword: CrosswordData;
}

const { id, title, crossword } = Astro.props;

const gridPanelId = `${id}-grid`;
const acrossPanelId = `${id}-across`;
const downPanelId = `${id}-down`;

const clueGroups = [
  {
    key: "across",
    label: "Orizzontali",
    clues: crossword.across,
    panelId: acrossPanelId,
  },
  {
    key: "down",
    label: "Verticali",
    clues: crossword.down,
    panelId: downPanelId,
  },
] as const;

const model = crossword.layout
  ? buildCrosswordModel(crossword.layout, {
      across: crossword.across,
      down: crossword.down,
    })
  : null;

const wordKeysByCell = new Map<
  string,
  Partial<Record<CrosswordDirection, string>>
>();

for (const word of model?.words ?? []) {
  for (const cellKey of word.cells) {
    const wordKeys = wordKeysByCell.get(cellKey) ?? {};
    wordKeys[word.direction] = word.key;
    wordKeysByCell.set(cellKey, wordKeys);
  }
}

const cellFontSize = model
  ? `${55 / model.columns}cqi`
  : undefined;
---

<section
  class="crossword-reader"
  data-crossword-reader="true"
  data-active-clues="across"
  data-mobile-panel="grid"
  data-crossword-id={id}
  data-crossword-layout={crossword.layout?.join("/")}
  data-crossword-rows={model?.rows}
  data-crossword-columns={model?.columns}
  aria-label={`Lettore di ${title}`}
>
  <div
    class="crossword-reader__mobile-controls"
    role="group"
    aria-label="Scegli cosa visualizzare"
  >
    <button
      type="button"
      data-crossword-mobile-button="grid"
      aria-controls={gridPanelId}
      aria-pressed="true"
    >
      Schema
    </button>

    {
      clueGroups.map((group) => (
        <button
          type="button"
          data-crossword-mobile-button={group.key}
          aria-controls={group.panelId}
          aria-pressed="false"
        >
          {group.label}
        </button>
      ))
    }
  </div>

  <div class="crossword-reader__layout">
    <figure
      id={gridPanelId}
      class="crossword-reader__grid"
      data-crossword-mobile-panel="grid"
    >
      <div class="crossword-reader__grid-frame">
        <div
          class="crossword-reader__grid-canvas"
          style={model
            ? `--crossword-rows: ${model.rows}; --crossword-columns: ${model.columns}; --crossword-cell-font: ${cellFontSize};`
            : undefined}
        >
          <img
            src={publicAsset(crossword.gridAsset)}
            alt={`Schema vuoto di ${title}`}
            width="1638"
            height="1638"
            loading="eager"
            decoding="async"
            draggable="false"
          />

          {
            model && (
              <div
                class="crossword-reader__writing-grid"
                role="group"
                aria-label={`Caselle compilabili di ${title}`}
              >
                {model.cells.map((cell) => {
                  const wordKeys =
                    wordKeysByCell.get(cell.key) ?? {};

                  return (
                    <input
                      type="text"
                      class="crossword-reader__cell"
                      maxlength="1"
                      autocomplete="off"
                      autocapitalize="characters"
                      autocorrect="off"
                      spellcheck="false"
                      inputmode="text"
                      enterkeyhint="enter"
                      aria-label={`Riga ${
                        cell.row + 1
                      }, colonna ${cell.column + 1}${
                        cell.number
                          ? `, numero ${cell.number}`
                          : ""
                      }`}
                      data-crossword-cell={cell.key}
                      data-crossword-row={cell.row}
                      data-crossword-column={cell.column}
                      data-crossword-across={wordKeys.across}
                      data-crossword-down={wordKeys.down}
                      style={`grid-row: ${
                        cell.row + 1
                      }; grid-column: ${cell.column + 1};`}
                    />
                  );
                })}
              </div>
            )
          }
        </div>
      </div>

      <p
        class="crossword-reader__active-clue"
        data-crossword-active-clue
        aria-live="polite"
        hidden
      >
        <span data-crossword-active-direction></span>

        <span
          class="crossword-reader__active-clue-number"
          data-crossword-active-number
        ></span>

        <span data-crossword-active-text></span>
      </p>

      <figcaption>
        <span>
          Schema del cruciverba. Le definizioni si trovano a fianco.
        </span>

        <span class="crossword-reader__storage-tools">
          <span
            data-crossword-storage-status
            aria-live="polite"
          >
            I progressi vengono salvati su questo dispositivo.
          </span>

          <button
            type="button"
            class="crossword-reader__reset"
            data-crossword-reset
          >
            Cancella schema
          </button>
        </span>
      </figcaption>
    </figure>

    <div class="crossword-reader__definitions">
      <div
        class="crossword-reader__desktop-controls"
        role="group"
        aria-label="Direzione delle definizioni"
      >
        {
          clueGroups.map((group) => (
            <button
              type="button"
              data-crossword-clue-button={group.key}
              aria-controls={group.panelId}
              aria-pressed={group.key === "across" ? "true" : "false"}
            >
              {group.label}
            </button>
          ))
        }
      </div>

      {
        clueGroups.map((group) => (
          <section
            id={group.panelId}
            class="crossword-reader__clue-group"
            data-crossword-clue-panel={group.key}
            data-crossword-mobile-panel={group.key}
          >
            <h2>{group.label}</h2>

            {group.clues.length > 0 ? (
              <ul class="crossword-reader__clue-list">
                {group.clues.map((clue) => (
                  <li>
                    <button
                      id={`${id}-${group.key}-${
                        clue.number
                      }-clue`}
                      type="button"
                      class="crossword-reader__clue"
                      data-crossword-word={`${
                        group.key
                      }-${clue.number}`}
                      data-crossword-direction={group.key}
                      data-crossword-number={clue.number}
                      aria-pressed="false"
                    >
                      <span
                        class="crossword-reader__clue-number"
                        aria-hidden="true"
                      >
                        {clue.number}
                      </span>

                      <span data-crossword-clue-text>
                        {clue.text}
                      </span>
                    </button>
                  </li>
                ))}
              </ul>
            ) : (
              <p>Nessuna definizione disponibile.</p>
            )}
          </section>
        ))
      }
    </div>
  </div>

</section>

<style>
  .crossword-reader {
    margin-block: 2rem 3rem;
  }

  .crossword-reader__layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1.08fr)
      minmax(20rem, 0.92fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .crossword-reader__grid {
    position: sticky;
    top: 1rem;
    min-width: 0;
    margin: 0;
  }

  .crossword-reader__grid-frame {
    padding: clamp(0.35rem, 1vw, 0.65rem);
    border: 4px solid var(--frame-main);
    background: #fff;
    box-shadow:
      0 0 0 1px var(--frame-dark),
      inset 0 0 0 1px var(--frame-highlight),
      0.45rem 0.55rem 0 color-mix(
        in srgb,
        var(--ink) 16%,
        transparent
      );
  }

  .crossword-reader__grid img {
    display: block;
    width: 100%;
    height: auto;
  }

  .crossword-reader__grid-canvas {
    position: relative;
    container-type: inline-size;
  }

  .crossword-reader__grid-canvas img {
    user-select: none;
  }

  .crossword-reader__writing-grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows:
      repeat(var(--crossword-rows), minmax(0, 1fr));
    grid-template-columns:
      repeat(var(--crossword-columns), minmax(0, 1fr));
    pointer-events: none;
  }

  .crossword-reader__cell {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    height: 100%;
    padding: 0.16em 0 0;
    margin: 0;
    appearance: none;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #111;
    caret-color: transparent;
    font-family: Arial, sans-serif;
    font-size: clamp(
      0.72rem,
      var(--crossword-cell-font),
      3rem
    );
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    pointer-events: auto;
    touch-action: manipulation;
  }

  .crossword-reader__cell.is-in-word {
    background: rgb(105 190 255 / 27%);
  }

  .crossword-reader__cell:focus {
    outline: 2px solid rgb(20 115 175 / 80%);
    outline-offset: -2px;
    background: rgb(75 175 245 / 38%);
  }

  .crossword-reader__active-clue {
    display: none;
  }

  .crossword-reader__grid figcaption {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.75rem;
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .crossword-reader__storage-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem 0.8rem;
  }

  .crossword-reader__reset {
    min-height: auto;
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .crossword-reader__reset:hover {
    background: color-mix(
      in srgb,
      var(--paper-raised) 75%,
      var(--resident)
    );
  }

  .crossword-reader__reset:focus-visible {
    outline: 2px solid var(--resident);
    outline-offset: 2px;
  }

  .crossword-reader__definitions {
    min-width: 0;
  }

  .crossword-reader__desktop-controls,
  .crossword-reader__mobile-controls {
    gap: 0;
  }

  .crossword-reader__desktop-controls {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-bottom: 1rem;
    background: var(--paper);
  }

  .crossword-reader__mobile-controls {
    display: none;
  }

  .crossword-reader__desktop-controls button,
  .crossword-reader__mobile-controls button {
    min-height: 2.8rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.86rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .crossword-reader__desktop-controls button + button,
  .crossword-reader__mobile-controls button + button {
    border-left: 0;
  }

  .crossword-reader__desktop-controls button:hover,
  .crossword-reader__mobile-controls button:hover {
    background: color-mix(
      in srgb,
      var(--paper-raised) 75%,
      var(--resident)
    );
  }

  .crossword-reader__desktop-controls button:focus-visible,
  .crossword-reader__mobile-controls button:focus-visible {
    position: relative;
    z-index: 1;
    outline: 2px solid var(--resident);
    outline-offset: 2px;
  }

  .crossword-reader__desktop-controls button[aria-pressed="true"],
  .crossword-reader__mobile-controls button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
  }

  .crossword-reader__clue-group {
    display: none;
  }

  .crossword-reader__clue-group h2 {
    margin: 0 0 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 500;
  }

  .crossword-reader__clue-list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .crossword-reader__clue-list li {
    padding: 0;
  }

  .crossword-reader__clue {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.45rem;
    width: 100%;
    padding: 0.18rem 0.3rem;
    border: 0;
    border-left: 3px solid transparent;
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: clamp(
      1rem,
      calc(1.05vw + 0.08rem),
      1.08rem
    );
    line-height: 1.18;
    text-align: left;
  }

  .crossword-reader__clue:hover {
    background: color-mix(
      in srgb,
      var(--resident) 12%,
      transparent
    );
  }

  .crossword-reader__clue:focus-visible {
    outline: 2px solid var(--resident);
    outline-offset: 1px;
  }

  .crossword-reader__clue[aria-pressed="true"] {
    border-left-color: var(--resident);
    background: color-mix(
      in srgb,
      var(--resident) 18%,
      transparent
    );
  }

  .crossword-reader__clue-number {
    color: var(--resident);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  @media (min-width: 761px) {
    .crossword-reader[data-active-clues="across"]
      .crossword-reader__clue-group[data-crossword-clue-panel="across"],
    .crossword-reader[data-active-clues="down"]
      .crossword-reader__clue-group[data-crossword-clue-panel="down"] {
      display: block;
    }
  }

  @media (max-width: 760px) {
    .crossword-reader {
      margin-top: 1.5rem;
    }

    .crossword-reader__mobile-controls {
      position: sticky;
      top: 0;
      z-index: 3;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-bottom: 1rem;
      background: var(--paper);
    }

    .crossword-reader__mobile-controls button {
      padding-inline: 0.35rem;
      font-size: 0.72rem;
    }

    .crossword-reader__desktop-controls {
      display: none;
    }

    .crossword-reader__layout {
      display: block;
    }

    .crossword-reader__grid {
      position: static;
      display: none;
    }

    .crossword-reader__clue-group {
      display: none;
    }

    .crossword-reader[data-mobile-panel="grid"]
      .crossword-reader__grid {
      display: block;
    }

    .crossword-reader[data-mobile-panel="across"]
      .crossword-reader__clue-group[data-crossword-mobile-panel="across"],
    .crossword-reader[data-mobile-panel="down"]
      .crossword-reader__clue-group[data-crossword-mobile-panel="down"] {
      display: block;
    }

    .crossword-reader__active-clue:not([hidden]) {
      display: grid;
      grid-template-columns: auto auto minmax(0, 1fr);
      gap: 0.35rem;
      margin: 0.7rem 0 0;
      padding: 0.45rem 0.55rem;
      background: color-mix(
        in srgb,
        var(--resident) 12%,
        var(--paper-raised)
      );
      font-size: 0.9rem;
      line-height: 1.3;
    }

    .crossword-reader__active-clue-number {
      color: var(--resident);
      font-family: var(--font-mono);
      font-weight: 700;
    }

    .crossword-reader__storage-tools {
      align-items: flex-start;
      flex-direction: column;
    }

    .crossword-reader__clue {
      grid-template-columns: 1.8rem minmax(0, 1fr);
      gap: 0.4rem;
    }
  }
</style>

<script>
  import { initializeCrosswordReaders } from
    "../lib/crossword-interactions";

  initializeCrosswordReaders();

  document.addEventListener(
    "astro:page-load",
    initializeCrosswordReaders,
  );
</script>
