---
import type { CollectionEntry } from "astro:content";
import { publicAsset } from "../lib/urls";

type ArtifactEntry = CollectionEntry<"artifacts">;
type CrosswordData = NonNullable<ArtifactEntry["data"]["crossword"]>;

interface Props {
  id: string;
  title: string;
  crossword: CrosswordData;
}

const { id, title, crossword } = Astro.props;

const gridPanelId = `${id}-grid`;
const acrossPanelId = `${id}-across`;
const downPanelId = `${id}-down`;

const clueGroups = [
  {
    key: "across",
    label: "Orizzontali",
    clues: crossword.across,
    panelId: acrossPanelId,
  },
  {
    key: "down",
    label: "Verticali",
    clues: crossword.down,
    panelId: downPanelId,
  },
] as const;
---

<section
  class="crossword-reader"
  data-crossword-reader="true"
  data-active-clues="across"
  data-mobile-panel="grid"
  aria-label={`Lettore di ${title}`}
>
  <div
    class="crossword-reader__mobile-controls"
    role="group"
    aria-label="Scegli cosa visualizzare"
  >
    <button
      type="button"
      data-crossword-mobile-button="grid"
      aria-controls={gridPanelId}
      aria-pressed="true"
    >
      Schema
    </button>

    {
      clueGroups.map((group) => (
        <button
          type="button"
          data-crossword-mobile-button={group.key}
          aria-controls={group.panelId}
          aria-pressed="false"
        >
          {group.label}
        </button>
      ))
    }
  </div>

  <div class="crossword-reader__layout">
    <figure
      id={gridPanelId}
      class="crossword-reader__grid"
      data-crossword-mobile-panel="grid"
    >
      <div class="crossword-reader__grid-frame">
        <img
          src={publicAsset(crossword.gridAsset)}
          alt={`Schema vuoto di ${title}`}
          width="1638"
          height="1638"
          loading="eager"
          decoding="async"
        />
      </div>

      <figcaption>
        Schema del cruciverba. Le definizioni si trovano a fianco.
      </figcaption>
    </figure>

    <div class="crossword-reader__definitions">
      <div
        class="crossword-reader__desktop-controls"
        role="group"
        aria-label="Direzione delle definizioni"
      >
        {
          clueGroups.map((group) => (
            <button
              type="button"
              data-crossword-clue-button={group.key}
              aria-controls={group.panelId}
              aria-pressed={group.key === "across" ? "true" : "false"}
            >
              {group.label}
            </button>
          ))
        }
      </div>

      {
        clueGroups.map((group) => (
          <section
            id={group.panelId}
            class="crossword-reader__clue-group"
            data-crossword-clue-panel={group.key}
            data-crossword-mobile-panel={group.key}
          >
            <h2>{group.label}</h2>

            {group.clues.length > 0 ? (
              <ul class="crossword-reader__clue-list">
                {group.clues.map((clue) => (
                  <li>
                    <span
                      class="crossword-reader__clue-number"
                      aria-label={`Definizione ${clue.number}`}
                    >
                      {clue.number}
                    </span>

                    <span>{clue.text}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p>Nessuna definizione disponibile.</p>
            )}
          </section>
        ))
      }
    </div>
  </div>

</section>

<style>
  .crossword-reader {
    margin-block: 2rem 3rem;
  }

  .crossword-reader__layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1.08fr)
      minmax(20rem, 0.92fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .crossword-reader__grid {
    position: sticky;
    top: 1rem;
    min-width: 0;
    margin: 0;
  }

  .crossword-reader__grid-frame {
    padding: clamp(0.35rem, 1vw, 0.65rem);
    border: 4px solid var(--frame-main);
    background: #fff;
    box-shadow:
      0 0 0 1px var(--frame-dark),
      inset 0 0 0 1px var(--frame-highlight),
      0.45rem 0.55rem 0 color-mix(
        in srgb,
        var(--ink) 16%,
        transparent
      );
  }

  .crossword-reader__grid img {
    display: block;
    width: 100%;
    height: auto;
  }

  .crossword-reader__grid figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .crossword-reader__definitions {
    min-width: 0;
  }

  .crossword-reader__desktop-controls,
  .crossword-reader__mobile-controls {
    gap: 0;
  }

  .crossword-reader__desktop-controls {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-bottom: 1rem;
    background: var(--paper);
  }

  .crossword-reader__mobile-controls {
    display: none;
  }

  .crossword-reader button {
    min-height: 2.8rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.86rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .crossword-reader button + button {
    border-left: 0;
  }

  .crossword-reader button:hover {
    background: color-mix(
      in srgb,
      var(--paper-raised) 75%,
      var(--resident)
    );
  }

  .crossword-reader button:focus-visible {
    position: relative;
    z-index: 1;
    outline: 2px solid var(--resident);
    outline-offset: 2px;
  }

  .crossword-reader button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
  }

  .crossword-reader__clue-group {
    display: none;
  }

  .crossword-reader__clue-group h2 {
    margin: 0 0 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 500;
  }

    .crossword-reader__clue-list {
    padding: 0;
    margin: 0;
    list-style: none;
    }

    .crossword-reader__clue-list li {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.45rem;
    padding-block: 0.18rem;
    font-size: clamp(
    1rem,
    calc(1.05vw + 0.08rem),
    1.08rem
    );
    line-height: 1.18;
    }

    .crossword-reader__clue-number {
    color: var(--resident);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    }


  @media (min-width: 761px) {
    .crossword-reader[data-active-clues="across"]
      .crossword-reader__clue-group[data-crossword-clue-panel="across"],
    .crossword-reader[data-active-clues="down"]
      .crossword-reader__clue-group[data-crossword-clue-panel="down"] {
      display: block;
    }
  }

  @media (max-width: 760px) {
    .crossword-reader {
      margin-top: 1.5rem;
    }

    .crossword-reader__mobile-controls {
      position: sticky;
      top: 0;
      z-index: 3;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-bottom: 1rem;
      background: var(--paper);
    }

    .crossword-reader__mobile-controls button {
      padding-inline: 0.35rem;
      font-size: 0.72rem;
    }

    .crossword-reader__desktop-controls {
      display: none;
    }

    .crossword-reader__layout {
      display: block;
    }

    .crossword-reader__grid {
      position: static;
      display: none;
    }

    .crossword-reader__clue-group {
      display: none;
    }

    .crossword-reader[data-mobile-panel="grid"]
      .crossword-reader__grid {
      display: block;
    }

    .crossword-reader[data-mobile-panel="across"]
      .crossword-reader__clue-group[data-crossword-mobile-panel="across"],
    .crossword-reader[data-mobile-panel="down"]
      .crossword-reader__clue-group[data-crossword-mobile-panel="down"] {
      display: block;
    }

    .crossword-reader__clue-list li {
    grid-template-columns: 1.8rem minmax(0, 1fr);
    gap: 0.4rem;
    }

  }
</style>

<script>
  const initializeCrosswordReaders = () => {
    document
      .querySelectorAll<HTMLElement>("[data-crossword-reader]")
      .forEach((reader) => {
        if (reader.dataset.crosswordReaderInitialized === "true") {
          return;
        }

        reader.dataset.crosswordReaderInitialized = "true";

        const clueButtons =
          reader.querySelectorAll<HTMLButtonElement>(
            "[data-crossword-clue-button]",
          );

        const mobileButtons =
          reader.querySelectorAll<HTMLButtonElement>(
            "[data-crossword-mobile-button]",
          );

        const setClueDirection = (direction: string) => {
          reader.dataset.activeClues = direction;

          clueButtons.forEach((button) => {
            const isActive =
              button.dataset.crosswordClueButton === direction;

            button.setAttribute(
              "aria-pressed",
              String(isActive),
            );
          });
        };

        const setMobilePanel = (panel: string) => {
          reader.dataset.mobilePanel = panel;

          mobileButtons.forEach((button) => {
            const isActive =
              button.dataset.crosswordMobileButton === panel;

            button.setAttribute(
              "aria-pressed",
              String(isActive),
            );
          });

          if (panel === "across" || panel === "down") {
            setClueDirection(panel);
          }
        };

        clueButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const direction =
              button.dataset.crosswordClueButton;

            if (direction) {
              setClueDirection(direction);
            }
          });
        });

        mobileButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const panel =
              button.dataset.crosswordMobileButton;

            if (panel) {
              setMobilePanel(panel);
            }
          });
        });
      });
  };

  initializeCrosswordReaders();

  document.addEventListener(
    "astro:page-load",
    initializeCrosswordReaders,
  );
</script>