---
interface Props {
  title: string;
  subtitle?: string;
  introduction?: string;
}

const {
  title,
  subtitle,
  introduction,
} = Astro.props;

const introductionLines = introduction
  ? introduction
      .split(/\r?\n/)
      .map((line) => line.trim())
      .filter(Boolean)
  : [];
---

<header class:list={["section-page-header", { "section-page-header--controls": Astro.slots.has("controls") }]}>
  <div class="section-page-header__heading">
    <h1>
      <span class="section-page-header__title">
        {title}
      </span>

      {subtitle && (
        <span class="section-page-header__subtitle">
          {subtitle}
        </span>
      )}
    </h1>
  </div>

  <slot name="controls" />

  {
    introduction && (
      <p class="section-page-header__introduction">
        {
          introductionLines.map((line, index) => (
            <span
              class="section-page-header__introduction-line"
            >
              {line}
              {
                index < introductionLines.length - 1 &&
                  " "
              }
            </span>
          ))
        }
      </p>
    )
  }
</header>

<style>
  .section-page-header--controls {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 1rem;
  }
  .section-page-header--controls .section-page-header__introduction {
    width: min(100%, 38rem);
    min-width: 0;
  }
  @media (max-width: 600px) {
    .section-page-header--controls { column-gap: .6rem; }
  }
</style>
