---
import crowSprite from "../assets/navigation/crow/Crow.png";

---

<div
  class="navigation-crow"
  data-navigation-crow
  data-facing="left"
  data-sprite-src={crowSprite.src}
  aria-hidden="true"
  transition:persist="navigation-crow"
  hidden
>
  <span
    class="navigation-crow__sprite"
    data-navigation-crow-sprite
    style={`background-image: url("${crowSprite.src}")`}
  ></span>
</div>

<style>
  .navigation-crow {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;

    width: 64px;
    height: 64px;

    pointer-events: none;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .navigation-crow__sprite {
    display: block;
    width: 64px;
    height: 64px;

    background-repeat: no-repeat;
    background-position: -64px 0;
    background-size: 3584px 64px;

    image-rendering: crisp-edges;
    image-rendering: pixelated;
    transform-origin: center center;
  }

  .navigation-crow[data-facing="right"] .navigation-crow__sprite {
    transform: scaleX(-1);
  }
</style>

<script>
  const FRAME_SIZE = 64;
  const FRAME_COUNT = 56;
  const LAST_SECTION_KEY = "fabrizios-webhome:crow-last-section";
  const LANDING_APPROACH_MS = 150;

  const IDLE_FRAMES = [1, 2, 3, 4] as const;
  const IDLE_DURATIONS = [130, 170, 140, 200] as const;
  const TAKEOFF_START_FRAMES = [34, 35] as const;
  const TAKEOFF_START_DURATIONS = [220, 100] as const;
  const TAKEOFF_END_FRAMES = [36, 37] as const;
  const TAKEOFF_END_DURATIONS = [100, 100] as const;
  const FLY_FRAMES = [38, 39, 40, 41, 42, 43] as const;
  const FLY_DURATIONS = [100, 100, 100, 100, 100, 100] as const;
  const LANDING_FRAMES = [44, 34] as const;
  const LANDING_DURATIONS = [140, 190] as const;

  // Coordinate del corvo fermo nel fotogramma 64 × 64 e margini sul tasto.
  const IDLE_VISIBLE_RIGHT = 47;
  const IDLE_FOOT_LINE = 47;
  const PERCH_RIGHT_INSET = 4;
  const PERCH_TOP_OFFSET = 1;

  type Point = { x: number; y: number };
  type CrowPhase = "idle" | "takeoff" | "flight" | "landing";
  type CrowController = {
    element: HTMLElement;
    readonly navigation: HTMLElement | null;
    bind: (navigation: HTMLElement, section: string) => void;
    requestDestination: (section: string) => void;
    prepareNavigation: () => void;
    dispose: () => void;
  };

  const loadImage = (src: string) =>
    new Promise<HTMLImageElement>((resolve, reject) => {
      const image = new Image();
      image.addEventListener("load", () => resolve(image), { once: true });
      image.addEventListener("error", () => reject(
        new Error(`Unable to load crow sprite: ${src}`),
      ), { once: true });
      image.src = src;
    });

  const readPreviousSection = () => {
    try {
      return sessionStorage.getItem(LAST_SECTION_KEY);
    } catch {
      return null;
    }
  };

  const rememberSection = (section: string) => {
    try {
      sessionStorage.setItem(LAST_SECTION_KEY, section);
    } catch {
      // L'animazione resta utilizzabile anche senza sessionStorage.
    }
  };

  const createNavigationCrow = (
    crowElement: HTMLElement,
    spriteElement: HTMLElement,
    initialSection: string,
    spriteSrc: string,
  ): CrowController => {
    let navigationElement: HTMLElement | null = null;
    let requestedSection = initialSection;
    let perchedSection = readPreviousSection() ?? initialSection;
    let flightSection = initialSection;
    let phase: CrowPhase = "idle";
    let disposed = false;
    let running = false;
    let layoutReady = false;
    let spriteLoaded = false;
    const layoutWaiters = new Set<() => void>();
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

    let movementAnimation: Animation | null = null;
    let movementDuration = 0;
    let frameSequenceToken = 0;
    let frameTimer: number | null = null;
    let finishFrameWait: (() => void) | null = null;
    let repositionFrame: number | null = null;

    const stopFrameSequence = () => {
      frameSequenceToken += 1;
      if (frameTimer !== null) clearTimeout(frameTimer);
      frameTimer = null;
      const finish = finishFrameWait;
      finishFrameWait = null;
      finish?.();
    };

    const setFrame = (frame: number) => {
      spriteElement.style.backgroundPosition = `${-frame * FRAME_SIZE}px 0`;
    };

    const playFrameSequence = async (
      frames: readonly number[],
      durations: readonly number[],
      loop = false,
    ) => {
      stopFrameSequence();
      const token = frameSequenceToken;
      do {
        for (let index = 0; index < frames.length; index += 1) {
          if (disposed || token !== frameSequenceToken) return;
          setFrame(frames[index]);
          await new Promise<void>((resolve) => {
            finishFrameWait = resolve;
            frameTimer = window.setTimeout(() => {
              frameTimer = null;
              finishFrameWait = null;
              resolve();
            }, durations[index] ?? 100);
          });
        }
      } while (loop && !disposed && token === frameSequenceToken);
    };

    const playFlightFrames = async () => {
      const takeoff = playFrameSequence(TAKEOFF_END_FRAMES, TAKEOFF_END_DURATIONS);
      const token = frameSequenceToken;
      await takeoff;
      if (!disposed && token === frameSequenceToken) {
        void playFrameSequence(FLY_FRAMES, FLY_DURATIONS, true);
      }
    };

    const getPerchPoint = (section: string): Point | null => {
      const button = Array.from(
        navigationElement?.querySelectorAll<HTMLElement>("[data-nav-button]") ?? [],
      ).find((entry) => entry.dataset.section === section);
      if (!button || !navigationElement) return null;
      const navRect = navigationElement.getBoundingClientRect();
      const buttonRect = button.getBoundingClientRect();
      // Il clic abbassa il tasto di 2px: la meta resta sul bordo nella posizione di riposo.
      const press = new DOMMatrixReadOnly(getComputedStyle(button).transform);
      return {
        x: Math.round(buttonRect.right - navRect.left - press.m41 - PERCH_RIGHT_INSET - IDLE_VISIBLE_RIGHT),
        y: Math.round(buttonRect.top - navRect.top - press.m42 - IDLE_FOOT_LINE + PERCH_TOP_OFFSET),
      };
    };

    const placeCrow = (point: Point) => {
      crowElement.style.transform = `translate3d(${point.x}px, ${point.y}px, 0)`;
    };

    const readPosition = (): Point => {
      const matrix = new DOMMatrixReadOnly(getComputedStyle(crowElement).transform);
      return { x: matrix.m41, y: matrix.m42 };
    };

    const setFacing = (from: Point, to: Point) => {
      crowElement.dataset.facing = to.x >= from.x ? "right" : "left";
    };

    const stopMovement = () => {
      if (!movementAnimation) return;
      // Salviamo la posizione visibile prima di rimuovere l'effetto dell'animazione.
      placeCrow(readPosition());
      movementAnimation.cancel();
    };

    const flyBetween = async (from: Point, to: Point): Promise<boolean> => {
      const deltaX = to.x - from.x;
      const deltaY = to.y - from.y;
      const distance = Math.hypot(deltaX, deltaY);
      const lift = Math.min(48, Math.max(24, distance * 0.14));
      movementDuration = Math.round(Math.min(1050, Math.max(650, distance * 2.1)));
      const keyframes = Array.from({ length: 9 }, (_, index) => {
        const progress = index / 8;
        return {
          transform: `translate3d(${from.x + deltaX * progress}px, ${from.y + deltaY * progress - 4 * lift * progress * (1 - progress)}px, 0)`,
        };
      });
      const animation = crowElement.animate(keyframes, {
        duration: movementDuration,
        easing: "linear",
        fill: "forwards",
      });
      movementAnimation = animation;
      try {
        await animation.finished;
        if (disposed) return false;
        placeCrow(to);
        return true;
      } catch {
        return false;
      } finally {
        animation.cancel();
        if (movementAnimation === animation) movementAnimation = null;
      }
    };

    const releaseLayoutWaiters = () => {
      layoutWaiters.forEach((resolve) => resolve());
      layoutWaiters.clear();
    };

    const waitForLayout = async () => {
      while (!layoutReady && !disposed) {
        await new Promise<void>((resolve) => layoutWaiters.add(resolve));
      }
    };

    const runMotion = async () => {
      if (running || disposed || !layoutReady) return;
      running = true;
      try {
        while (!disposed) {
          await waitForLayout();
          if (disposed) return;
          if (reducedMotion.matches) {
            perchedSection = requestedSection;
            placeCrow(getPerchPoint(perchedSection)!);
            phase = "idle";
            break;
          }
          if (perchedSection === requestedSection) break;

          phase = "takeoff";
          const origin = getPerchPoint(perchedSection) ?? readPosition();
          placeCrow(origin);
          setFacing(origin, getPerchPoint(requestedSection)!);
          await playFrameSequence(TAKEOFF_START_FRAMES, TAKEOFF_START_DURATIONS);
          await waitForLayout();
          if (disposed) return;
          // Un clic durante il decollo aggiorna la destinazione senza spostare la partenza.
          if (reducedMotion.matches || perchedSection === requestedSection) {
            phase = "idle";
            continue;
          }

          phase = "flight";
          void playFlightFrames();
          while (!disposed) {
            await waitForLayout();
            if (disposed) return;
            if (reducedMotion.matches) break;
            const destination = requestedSection;
            const target = getPerchPoint(destination)!;
            const from = readPosition();
            flightSection = destination;
            setFacing(from, target);
            const arrived = await flyBetween(from, target);
            if (disposed) return;
            if (!arrived) continue; // Riparte dalla posizione salvata, senza un altro decollo.

            perchedSection = destination;
            phase = "landing";
            await waitForLayout();
            if (disposed) return;
            placeCrow(getPerchPoint(perchedSection)!);
            await playFrameSequence(LANDING_FRAMES, LANDING_DURATIONS);
            phase = "idle";
            break;
          }
        }
        if (!disposed) {
          crowElement.dataset.facing = "left";
          if (reducedMotion.matches) setFrame(IDLE_FRAMES[0]);
          else void playFrameSequence(IDLE_FRAMES, IDLE_DURATIONS, true);
        }
      } finally {
        running = false;
      }
    };

    const updateDestination = () => {
      if (!layoutReady || disposed) return;
      if (reducedMotion.matches) {
        stopFrameSequence();
        stopMovement();
      } else if (phase === "flight" && movementAnimation && flightSection !== requestedSection) {
        const remaining = movementDuration - Number(movementAnimation.currentTime ?? 0);
        // Nell'avvicinamento finale completiamo posa e atterraggio prima di ripartire.
        if (remaining > LANDING_APPROACH_MS) stopMovement();
      }
      void runMotion();
    };

    const repositionCrow = () => {
      repositionFrame = null;
      if (!disposed && layoutReady && phase === "idle") {
        const point = getPerchPoint(perchedSection);
        if (point) placeCrow(point);
      }
    };

    const requestCrowReposition = () => {
      if (!disposed && repositionFrame === null) {
        repositionFrame = requestAnimationFrame(repositionCrow);
      }
    };
    const resizeObserver = new ResizeObserver(requestCrowReposition);
    const visualViewport = window.visualViewport;

    const onNavigationLayout = () => {
      // Lo stesso stato usato dal menù per mostrarsi vale anche per il corvo.
      // Il controllo immediato copre un evento già emesso prima del collegamento.
      if (disposed || !spriteLoaded || !navigationElement
        || navigationElement.dataset.navigationLayoutReady !== "true") return;
      if (!layoutReady) {
        if (!getPerchPoint(perchedSection)) perchedSection = requestedSection;
        if (crowElement.hidden) {
          placeCrow(getPerchPoint(perchedSection)!);
          setFrame(IDLE_FRAMES[0]);
          crowElement.hidden = false;
        }
        layoutReady = true;
        releaseLayoutWaiters();
        updateDestination();
      }
      requestCrowReposition();
    };

    const detachNavigation = () => {
      resizeObserver.disconnect();
      navigationElement?.removeEventListener("webhome:navigation-layout", onNavigationLayout);
      if (repositionFrame !== null) cancelAnimationFrame(repositionFrame);
      repositionFrame = null;
    };

    const dispose = () => {
      disposed = true;
      stopFrameSequence();
      movementAnimation?.cancel();
      detachNavigation();
      releaseLayoutWaiters();
      window.removeEventListener("resize", requestCrowReposition);
      visualViewport?.removeEventListener("resize", requestCrowReposition);
      reducedMotion.removeEventListener("change", updateDestination);
    };

    window.addEventListener("resize", requestCrowReposition);
    visualViewport?.addEventListener("resize", requestCrowReposition);
    reducedMotion.addEventListener("change", updateDestination);

    // Il nodo e questo stato sopravvivono insieme ai cambi pagina di Astro.
    void loadImage(spriteSrc).then((image) => {
      if (image.naturalWidth !== FRAME_SIZE * FRAME_COUNT || image.naturalHeight !== FRAME_SIZE) {
        throw new Error(`Crow.png must be ${FRAME_SIZE * FRAME_COUNT} × ${FRAME_SIZE}px.`);
      }
      spriteLoaded = true;
      onNavigationLayout();
    }).catch((error) => {
      if (!disposed) {
        console.error(error);
        dispose();
      }
    });

    return {
      element: crowElement,
      get navigation() { return navigationElement; },
      requestDestination(section) {
        // Durante un movimento conta subito l'ultimo clic, anche se la pagina sta caricando.
        if (!running) return;
        requestedSection = section;
        updateDestination();
      },
      prepareNavigation() {
        layoutReady = false;
        detachNavigation();
        // Il volo continua; lo stile conserva anche una posizione di riserva durante lo swap.
        if (movementAnimation) placeCrow(readPosition());
      },
      bind(navigation, section) {
        detachNavigation();
        navigationElement = navigation;
        requestedSection = section;
        rememberSection(section);
        layoutReady = false;
        resizeObserver.observe(navigation);
        navigation.addEventListener("webhome:navigation-layout", onNavigationLayout);
        onNavigationLayout();
      },
      dispose,
    };
  };

  let controller: CrowController | null = null;
  const initializeNavigationCrows = () => {
    const navigation = document.querySelector<HTMLElement>("[data-crow-navigation]");
    const crow = navigation?.querySelector<HTMLElement>("[data-navigation-crow]");
    const sprite = crow?.querySelector<HTMLElement>("[data-navigation-crow-sprite]");
    const section = navigation?.querySelector<HTMLElement>('[data-nav-button][aria-current="page"]')?.dataset.section;
    if (!navigation || !crow || !sprite || !section || !crow.dataset.spriteSrc) {
      controller?.dispose();
      controller = null;
      return;
    }
    if (controller?.element !== crow) {
      controller?.dispose();
      controller = createNavigationCrow(crow, sprite, section, crow.dataset.spriteSrc);
    }
    if (controller.navigation !== navigation) controller.bind(navigation, section);
  };

  initializeNavigationCrows();
  document.addEventListener("astro:before-preparation", (event) => {
    const button = event.sourceElement?.closest<HTMLElement>("[data-nav-button]");
    const section = button?.dataset.section;
    if (section) controller?.requestDestination(section);
  });
  document.addEventListener("astro:before-swap", () => controller?.prepareNavigation());
  document.addEventListener("astro:after-swap", initializeNavigationCrows);
  document.addEventListener("astro:page-load", initializeNavigationCrows);
</script>
