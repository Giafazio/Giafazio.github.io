---
import CrosswordReader from
  "./CrosswordReader.astro";

import FourWordsGame from
  "./FourWordsGame.astro";

import ProjectTitleButton from
  "./ProjectTitleButton.astro";

import {
  type ArtifactEntry,
  type ProjectEntry,
  routeForEntry,
} from "../lib/content";

import {
  publicAsset,
  withBase,
} from "../lib/urls";

interface Props {
  artifact: ArtifactEntry;
  project?: ProjectEntry;
  previousArtifact?: ArtifactEntry;
  nextArtifact?: ArtifactEntry;
}

const {
  artifact,
  project,
  previousArtifact,
  nextArtifact,
} = Astro.props;

const crossword =
  artifact.data.crossword;

const fourWordsGame =
  artifact.data.fourWordsGame;

const gameProjectId =
  project?.data.id ?? "standalone";

const primaryActionLabel =
  project
    ? "Open PDF"
    : "Open file";

const naturalImagePreview =
  artifact.data.artifactKind === "image";
---

<article
  class:list={[
    !project && "experiment-article",
  ]}
  data-project={project?.data.id}
>
  <header
    class:list={[
      project
        ? [
            "project-detail-header",
            "project-detail-header--artifact",
          ]
        : [
            "article-header",
            "artifact-detail-heading",
          ],
    ]}
    data-project={project?.data.id}
  >
    {
      project && (
        <div class="project-detail-header__heading">
          <div class="project-detail-header__project-name">
            <ProjectTitleButton
              project={project}
              variant="heading"
            />
          </div>
        </div>
      )
    }

    <div
      class:list={[
        project &&
          "project-detail-header__copy",

        project &&
          "artifact-detail-heading",
      ]}
    >
      <div class="artifact-detail-heading__topline">
        <h1 class="artifact-detail-heading__title">
          {artifact.data.title}
        </h1>

        {
          crossword &&
          artifact.data.primaryAsset && (
            <a
              class="
                pdf-action-link
                artifact-detail-heading__pdf
              "
              href={publicAsset(
                artifact.data.primaryAsset,
              )}
            >
              Apri o stampa il PDF
            </a>
          )
        }
      </div>

      <p class="meta artifact-detail-heading__meta">
        {artifact.data.artifactKind}
        {" · "}
        {artifact.data.stage}

        {
          artifact.data.language && (
            <>
              {" · "}
              {
                artifact.data.language
                  .toUpperCase()
              }
            </>
          )
        }
      </p>

      {
        artifact.data.summary &&
        !fourWordsGame && (
          <p
            class="
              about-copy
              artifact-detail-heading__summary
            "
          >
            {artifact.data.summary}
          </p>
        )
      }
    </div>
  </header>

  {
    crossword ? (
      <CrosswordReader
        id={artifact.data.id}
        title={artifact.data.title}
        crossword={crossword}
      />
    ) : fourWordsGame ? (
      <FourWordsGame
        id={artifact.data.id}
        title={artifact.data.title}
        projectId={gameProjectId}
        game={fourWordsGame}
      />
    ) : artifact.data.previewAsset ? (
      <div
        class:list={[
          "artifact-preview",

          naturalImagePreview &&
            "artifact-preview--natural",

          artifact.data.previewRendering ===
            "pixelated" &&
            "artifact-preview--pixelated",
        ]}
      >
        <img
          src={publicAsset(
            artifact.data.previewAsset,
          )}
          alt={
            artifact.data.previewAlt ??
            `Preview of ${artifact.data.title}`
          }
          style={`object-fit: ${
            artifact.data.previewFit
          }; object-position: ${
            artifact.data.previewPosition ??
            "50% 50%"
          };`}
          decoding="async"
        />
      </div>
    ) : null
  }

  {
    previousArtifact &&
    nextArtifact && (
      <nav
        class="artifact-sequence-navigation"
        aria-label="Browse project artifacts"
      >
        <a
          class="artifact-sequence-navigation__link"
          href={withBase(
            routeForEntry(previousArtifact),
          )}
          aria-label={`Previous: ${previousArtifact.data.title}`}
          title={previousArtifact.data.title}
        >
          <span aria-hidden="true">←</span>
        </a>

        <a
          class="artifact-sequence-navigation__link"
          href={withBase(
            routeForEntry(nextArtifact),
          )}
          aria-label={`Next: ${nextArtifact.data.title}`}
          title={nextArtifact.data.title}
        >
          <span aria-hidden="true">→</span>
        </a>
      </nav>
    )
  }

  <div class="article-body">
    <slot />
  </div>

  {
    artifact.data.primaryAsset &&
    !crossword && (
      <div class="artifact-actions">
        <a
          href={publicAsset(
            artifact.data.primaryAsset,
          )}
        >
          {primaryActionLabel}
        </a>
      </div>
    )
  }
</article>