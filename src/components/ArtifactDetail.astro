---
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { imageMetadata } from "astro/assets/utils";
import CrosswordReader from
  "./CrosswordReader.astro";

import FourWordsGame from
  "./FourWordsGame.astro";

import ProjectTitleButton from
  "./ProjectTitleButton.astro";

import FattigattiAd from
  "./FattigattiAd.astro";

import {
  type ArtifactEntry,
  type ProjectEntry,
  routeForEntry,
} from "../lib/content";

import {
  publicAsset,
  withBase,
} from "../lib/urls";

interface Props {
  artifact: ArtifactEntry;
  project?: ProjectEntry;
  previousArtifact?: ArtifactEntry;
  nextArtifact?: ArtifactEntry;
}

const {
  artifact,
  project,
  previousArtifact,
  nextArtifact,
} = Astro.props;

const crossword =
  artifact.data.crossword;

const fourWordsGame =
  artifact.data.fourWordsGame;

const gameProjectId =
  project?.data.id ?? "standalone";

const pdfAsset =
  artifact.data.primaryAsset
    ?.toLowerCase()
    .endsWith(".pdf")
    ? artifact.data.primaryAsset
    : null;

const naturalImagePreview =
  artifact.data.artifactKind === "image";

// Reserve the image's height before fragment navigation, including on a cold load.
const sequenceImageSize = project?.data.artifactSequence && artifact.data.previewAsset
  ? await imageMetadata(await readFile(join(process.cwd(), "public", artifact.data.previewAsset)))
  : undefined;

function sequenceHref(entry: ArtifactEntry): string {
  const href = withBase(routeForEntry(entry));
  return entry.data.previewAsset && entry.data.showPreviewOnDetail !== false
    && !entry.data.crossword && !entry.data.fourWordsGame
    ? `${href}#artifact-image`
    : href;
}
---

<article
  class:list={[
    !project && "experiment-article",
  ]}
  data-project={project?.data.id}
>
  <header
    class:list={[
      project
        ? [
            "project-detail-header",
            "project-detail-header--artifact",
          ]
        : [
            "article-header",
            "artifact-detail-heading",
          ],
    ]}
    data-project={project?.data.id}
  >
    {
      project && (
        <div class="project-detail-header__heading">
          <div class="project-detail-header__project-name">
            <ProjectTitleButton
              project={project}
              variant="heading"
            />
          </div>
        </div>
      )
    }

    <div
      class:list={[
        project &&
          "project-detail-header__copy",

        project &&
          "artifact-detail-heading",
      ]}
    >
      <div class="artifact-detail-heading__topline">
        <h1 class="artifact-detail-heading__title">
          {artifact.data.title}
        </h1>

        {
          pdfAsset && (
            <a
              class="
                pdf-action-link
                artifact-detail-heading__pdf
              "
              href={publicAsset(pdfAsset)}
            >
              Apri o stampa il PDF
            </a>
          )
        }
      </div>

      <p class="meta artifact-detail-heading__meta">
        {artifact.data.artifactKind}
        {artifact.data.translation && " · Translation"}
        {artifact.data.medium && ` · ${artifact.data.medium}`}
        {" · "}
        {artifact.data.stage}

        {
          artifact.data.language && (
            <>
              {" · "}
              {
                artifact.data.language
                  .toUpperCase()
              }
            </>
          )
        }
      </p>

      {
        artifact.data.summary &&
        !fourWordsGame && (
          <p
            class="
              about-copy
              artifact-detail-heading__summary
            "
          >
            {artifact.data.summary}
          </p>
        )
      }
    </div>
  </header>

  {
    crossword ? (
      <CrosswordReader
        id={artifact.data.id}
        title={artifact.data.title}
        crossword={crossword}
      />
    ) : fourWordsGame ? (
      <FourWordsGame
        id={artifact.data.id}
        title={artifact.data.title}
        projectId={gameProjectId}
        game={fourWordsGame}
      />
    ) : artifact.data.previewAsset &&
      artifact.data.showPreviewOnDetail !== false ? (
      <div
        id="artifact-image"
        class:list={[
          "artifact-preview",

          naturalImagePreview &&
            "artifact-preview--natural",

          artifact.data.previewRendering ===
            "pixelated" &&
            "artifact-preview--pixelated",
        ]}
      >
        <img
          width={sequenceImageSize?.width}
          height={sequenceImageSize?.height}
          src={publicAsset(
            artifact.data.previewAsset,
          )}
          alt={
            artifact.data.previewAlt ??
            `Preview of ${artifact.data.title}`
          }
          style={`object-fit: ${
            artifact.data.previewFit
          }; object-position: ${
            artifact.data.previewPosition ??
            "50% 50%"
          };`}
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : null
  }

  {
    previousArtifact &&
    nextArtifact && (
      <nav
        class="artifact-sequence-navigation"
        aria-label="Browse project artifacts"
      >
        <a
          class="artifact-sequence-navigation__link"
          href={sequenceHref(previousArtifact)}
          aria-label={`Previous: ${previousArtifact.data.title}`}
          title={previousArtifact.data.title}
        >
          <span aria-hidden="true">←</span>
        </a>

        <a
          class="artifact-sequence-navigation__link"
          href={sequenceHref(nextArtifact)}
          aria-label={`Next: ${nextArtifact.data.title}`}
          title={nextArtifact.data.title}
        >
          <span aria-hidden="true">→</span>
        </a>
      </nav>
    )
  }

  <div class="article-body">
    <slot />
  </div>

  {
    artifact.data.primaryAsset &&
    !pdfAsset && (
      <div class="artifact-actions">
        <a
          href={publicAsset(
            artifact.data.primaryAsset,
          )}
        >
          Open file
        </a>
      </div>
    )
  }
  {
    artifact.data.id === "virgola" && (
      <FattigattiAd />
    )
}
</article>

<script>
  // ClientRouter can restore the old scroll position after resolving the fragment.
  async function revealSequenceImage() {
    if (window.location.hash !== "#artifact-image") return;
    const target = document.getElementById("artifact-image");
    const image = target?.querySelector("img");
    if (image) {
      image.loading = "eager";
      await image.decode().catch(() => {});
    }
    if (target?.isConnected && window.location.hash === "#artifact-image") {
      target.scrollIntoView({ behavior: "instant", block: "start" });
    }
  }
  document.addEventListener("astro:page-load", revealSequenceImage);
  void revealSequenceImage();
</script>
