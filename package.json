{
  "name": "fabrizio-personal-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build && node scripts/validate-build.mjs",
    "validate": "node scripts/validate-build.mjs",
    "preview": "astro preview",
    "test:routing": "node --experimental-strip-types --test tests/unit/routing.test.ts",
    "test:taxonomy": "node --experimental-strip-types --test tests/unit/taxonomy.test.ts",
    "test:browser": "npm run build && playwright test",
    "test:browser:built": "playwright test",
    "test:browser:report": "playwright show-report"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "@fontsource-variable/noto-serif-armenian": "^5.3.0",
    "@fontsource-variable/noto-serif-georgian": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/recursive": "^5.3.0",
    "@fontsource/cardo": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/kaisei-decol": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@fontsource/song-myung": "^5.3.1",
    "@fontsource/spectral": "^5.3.0",
    "astro": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
